{
  "expo": {
    "name": "AgriTrace",
    "slug": "agritrace",
    "scheme": "agritrace",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f4f7f3",
    "ios": {
      "bundleIdentifier": "dev.agritrace.app",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.agritrace.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f7f3",
          "dark": {
            "backgroundColor": "#0b1a12"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
