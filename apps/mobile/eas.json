{
  "build": {
    "development-consumer": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "consumer",
        "EXPO_PUBLIC_CONSUMER_PHONE_AUTH_ENABLED": "true"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=arm64-v8a,armeabi-v7a"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "staff",
        "EXPO_PUBLIC_CONSUMER_PHONE_AUTH_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "cli": {
    "appVersionSource": "local"
  }
}
