# On a phone, replace 127.0.0.1 with the Mac's current LAN address and API port.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api
# Match the origin encoded by the Web QR. The scanner extracts the token and
# queries API_BASE_URL; it does not open this localhost URL on the phone.
# Use the production customer origin (https://agritrace.dev) for release builds.
EXPO_PUBLIC_TRACE_ORIGIN=http://localhost:3000
EXPO_PUBLIC_APP_VARIANT=consumer
# Enable only after registering vn.agritrace.consumer in Firebase and providing
# matching google-services.json and SHA-1/SHA-256 for the installed APK.
EXPO_PUBLIC_CONSUMER_PHONE_AUTH_ENABLED=false
# GOOGLE_SERVICES_JSON=./google-services.json
