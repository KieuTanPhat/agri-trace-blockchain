DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/agri_traceDB?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_DAYS="30"
PORT=8080
RATE_LIMIT_TTL_MS="60000"
RATE_LIMIT_REQUESTS="120"
CORS_ORIGIN="http://localhost:3000"
PUBLIC_TRACE_BASE_URL="http://localhost:3000/trace"
FABRIC_ENABLED="false"
# Explicit release gate, default closed. Enable on isolated demo API and Worker.
ENTERPRISE_ONBOARDING_ENABLED="false"
# New registrations verify admin + enterprise email via a one-time OTP before review.
ENTERPRISE_WEB_BASE_URL="http://localhost:3000"
# Local demonstration only; forbidden when NODE_ENV=production.
ENTERPRISE_PAYMENT_SIMULATION_ENABLED="false"
# Collection is deferred by default. Approval and explicit admin activation
# still apply; this flag does not create subscriptions or payment records.
ENTERPRISE_PAYMENTS_ENABLED="false"
# SePay is server-only and stays disabled until configured. Start with Test mode.
# Test mode is refused in production; never use a live bank account for test QR.
SEPAY_MODE="disabled"
# SEPAY_MODE="test"
# SEPAY_BANK="Vietcombank"
# SEPAY_ACCOUNT_NUMBER="your-test-account"
# SEPAY_ACCOUNT_HOLDER="AGRITRACE TEST"
# SEPAY_WEBHOOK_KEY="generate-a-private-random-key-of-at-least-32-bytes"
# Optional official virtual account. Memo-based VA rules need separate setup.
# SEPAY_VIRTUAL_ACCOUNT="your-official-test-va"
# Human accounts must change their password after this many days; 0 disables.
PASSWORD_MAX_AGE_DAYS="30"
# Worker-only SMTP. See docs/email.md; use a Gmail App Password, not your login password.
MAIL_TRANSPORT="smtp"
MAIL_FROM=""
MAIL_FROM_NAME="AgriTrace"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
ENTERPRISE_WEB_BASE_URL="http://localhost:3000"
# Offline fixture testing only: explicitly set MAIL_TRANSPORT=mailpit.
# MAILPIT_API_URL="http://127.0.0.1:8025"
# Native consumer auth; signature verification uses public Google certificates.
CONSUMER_AUTH_ENABLED="false"
FIREBASE_PROJECT_ID=""
# Native staff-app sessions (refresh token in body); default closed.
STAFF_APP_AUTH_ENABLED="false"
# Private dev pilot only; production registration waits for approved legal text.
CONSUMER_DEV_REGISTRATION_ENABLED="false"
# Exact reviewed HTTPS image hostnames, comma-separated; empty disables news images.
# IPv4 public CDN only, no redirects; PNG/JPEG/static WebP <=384 KiB, <=2048px/4MP.
PUBLIC_NEWS_IMAGE_HOSTS=""
# Weather is off until selected; local educational testing only:
WEATHER_PROVIDER=""
WEATHER_LICENSE_MODE=""
WEATHER_PROVIDER_APPROVED="false"
# WEATHER_API_KEY belongs only in server environment for approved commercial service.
# Worker-only operator inventories, public endpoints and private identity PATHS:
# FABRIC_BINDINGS_CONFIG="/private/operator/bindings.json"
# ENTERPRISE_CONNECTIONS_CONFIG="/private/operator/enterprise-connections.json"
FABRIC_NETWORK_NAME="hyperledger-fabric"
FABRIC_WORKER_INTERVAL_MS="10000"
FABRIC_MAX_RETRIES="5"
FABRIC_CLAIM_LEASE_MS="120000"
IOT_INGEST_API_KEY="replace-with-a-long-random-device-ingest-key"
# Required when FABRIC_ENABLED=true (Worker only):
# FABRIC_BINDINGS_CONFIG="/path/to/bindings.json"
# Platform governance (SYSTEM_ADMIN). PLATFORM_SECRET_KEY encrypts TOTP seeds at
# rest: 32 random bytes as base64 (openssl rand -base64 32). Generate a distinct
# value per environment and keep it only in the private runtime env.
# PLATFORM_SECRET_KEY=""
# OPTIONAL (default) | REQUIRED | OFF
# PLATFORM_MFA_MODE="OPTIONAL"
# PLATFORM_LOGIN_MAX_ATTEMPTS="5"
# PLATFORM_LOGIN_LOCK_MINUTES="15"
