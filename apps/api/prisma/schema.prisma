  details        Json          @default("{}")
  prevHash       String        @map("prev_hash") @db.Char(64)
  entryHash      String        @unique(map: "uq_platform_audit_entry_hash") @map("entry_hash") @db.Char(64)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([occurredAt(sort: Desc), sequence(sort: Desc)], map: "ix_platform_audit_time")
  @@index([actorUserId, sequence(sort: Desc)], map: "ix_platform_audit_actor")
  @@index([action, sequence(sort: Desc)], map: "ix_platform_audit_action")
  @@index([subjectType, subjectId, sequence(sort: Desc)], map: "ix_platform_audit_subject")
  @@map("platform_audit")
}

model PlatformMfa {
  userId             String    @id @map("user_id") @db.Uuid
  secretCiphertext   String    @map("secret_ciphertext")
  status             String    @db.VarChar(10)
  recoveryCodeHashes Json      @default("[]") @map("recovery_code_hashes")
  lastUsedStep       BigInt?   @map("last_used_step")
  enabledAt          DateTime? @map("enabled_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("platform_mfa")
}

model PlatformApproval {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @map("platform_approval_id") @db.Uuid
  operation      String        @db.VarChar(40)
  subjectType    String        @map("subject_type") @db.VarChar(50)
  subjectId      String        @map("subject_id") @db.VarChar(64)
  organizationId String?       @map("organization_id") @db.Uuid
  payload        Json
  payloadHash    String        @map("payload_hash") @db.Char(64)
  proposerId     String        @map("proposer_id") @db.Uuid
  proposerReason String        @map("proposer_reason")
  status         String        @default("PENDING") @db.VarChar(12)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  decidedBy      String?       @map("decided_by") @db.Uuid
  decidedAt      DateTime?     @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?       @map("decision_note")
  result         Json?
  version        Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  proposer       User          @relation("PlatformApprovalProposer", fields: [proposerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decider        User?         @relation("PlatformApprovalDecider", fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, expiresAt], map: "ix_platform_approval_status")
  @@index([proposerId, createdAt(sort: Desc)], map: "ix_platform_approval_proposer")
  @@map("platform_approval")
}

model PlatformCase {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @map("platform_case_id") @db.Uuid
  caseNumber          BigInt              @default(dbgenerated("nextval('platform_case_number_seq')")) @unique(map: "uq_platform_case_number") @map("case_number")
  title               String              @db.VarChar(200)
  description         String
  category            String              @db.VarChar(20)
  severity            String              @db.VarChar(10)
  source              String              @db.VarChar(12)
  status              String              @default("OPEN") @db.VarChar(14)
  lotId               String?             @map("lot_id") @db.Uuid
  ownerOrganizationId String?             @map("owner_organization_id") @db.Uuid
  responseDueAt       DateTime?           @map("response_due_at") @db.Timestamptz(6)
  acknowledgedAt      DateTime?           @map("acknowledged_at") @db.Timestamptz(6)
  respondedAt         DateTime?           @map("responded_at") @db.Timestamptz(6)
  escalatedAt         DateTime?           @map("escalated_at") @db.Timestamptz(6)
  closedAt            DateTime?           @map("closed_at") @db.Timestamptz(6)
  closeReason         String?             @map("close_reason")
  createdBy           String              @map("created_by") @db.Uuid
  version             Int                 @default(0)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  lot                 Lot?                @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  owner               Organization?       @relation("PlatformCaseOwner", fields: [ownerOrganizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator             User                @relation("PlatformCaseCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  events              PlatformCaseEvent[]

  @@index([status, responseDueAt], map: "ix_platform_case_status")
  @@map("platform_case")
}

model PlatformCaseEvent {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @map("platform_case_event_id") @db.Uuid
  caseId              String       @map("platform_case_id") @db.Uuid
  action              String       @db.VarChar(20)
  visibility          String       @db.VarChar(8)
  actorUserId         String       @map("actor_user_id") @db.Uuid
  actorOrganizationId String?      @map("actor_organization_id") @db.Uuid
  note                String
  details             Json         @default("{}")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  case                PlatformCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor               User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organization        Organization? @relation(fields: [actorOrganizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([caseId, createdAt], map: "ix_platform_case_event_case")
  @@map("platform_case_event")
}

/// Internal notification thread of one organization; replies form a chat.
model EnterpriseMessageThread {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  subject String @db.VarChar(200)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  messages EnterpriseMessage[]
  participants EnterpriseMessageParticipant[]
  @@index([organizationId,lastMessageAt(sort: Desc)], map: "enterprise_message_thread_org")
  @@map("enterprise_message_thread")
}

model EnterpriseMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId String @map("thread_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  body String @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  thread EnterpriseMessageThread @relation(fields: [threadId], references: [id])
  @@index([threadId,createdAt], map: "enterprise_message_thread_time")
  @@map("enterprise_message")
}

model EnterpriseMessageParticipant {
  threadId String @map("thread_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  readAt DateTime? @map("read_at") @db.Timestamptz(6)
  thread EnterpriseMessageThread @relation(fields: [threadId], references: [id])
  @@id([threadId,userId])
  @@index([userId], map: "enterprise_message_participant_user")
  @@map("enterprise_message_participant")
}

/// Factor turning one unit of a processed product into the run's base unit.
/// Append-only; a conversion is revoked, never edited.
model ProductUnitConversion {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  unit      String    @db.VarChar(30)
  baseUnit  String    @map("base_unit") @db.VarChar(30)
  factor    Decimal   @db.Decimal(14, 6)
  note      String?   @db.VarChar(500)
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.Uuid
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason String? @map("revoke_reason") @db.VarChar(500)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([productId], map: "ix_unit_conversion_product")
  @@map("product_unit_conversion")
}

model ProductPhotoOrder {
  productId String @id @map("product_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  evidenceIds String[] @map("evidence_ids") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  updatedAt DateTime @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz(6)
  @@map("product_photo_order")
}
