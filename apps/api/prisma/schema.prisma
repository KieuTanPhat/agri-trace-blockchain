  lot                                                    lot                         @relation(fields: [lot_id], references: [lot_id], onUpdate: NoAction)
  organization_shipment_retailer_org_idToorganization    organization                @relation("shipment_retailer_org_idToorganization", fields: [retailer_org_id], references: [organization_id], onUpdate: NoAction)
  organization_shipment_transporter_org_idToorganization organization                @relation("shipment_transporter_org_idToorganization", fields: [transporter_org_id], references: [organization_id], onUpdate: NoAction)
  shipment_telemetry                                     shipment_telemetry[]
  shipment_telemetry_digest                              shipment_telemetry_digest?
  shipment_tracking_binding                              shipment_tracking_binding[]

  @@index([retailer_org_id], map: "ix_shipment_retailer")
  @@index([status], map: "ix_shipment_status")
  @@index([transporter_org_id], map: "ix_shipment_transporter")
