generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  FARM
  TRANSPORTER
  RETAILER
  AUDITOR
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum FarmStatus {
  ACTIVE
  INACTIVE
}

enum PlotStatus {
  ACTIVE
  INACTIVE
}

enum ProductionCycleState {
  CREATED
  PLANTED
  GROWING
  COMPLETED
  CANCELLED
}

enum CareType {
  WATERING
  FERTILIZING
  PEST_CONTROL
  WEEDING
  GROWTH_CHECK
  OTHER
}

enum DeviceType {
  TEMPERATURE
  HUMIDITY
  TEMPERATURE_HUMIDITY
  SOIL_MOISTURE
  OTHER
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
}

enum LotState {
  HARVESTED
  IN_TRANSPORT
  ARRIVED
  RETAIL_RECEIVED
  FOR_SALE
  SOLD
  RECALLED
  EXPIRED
  DAMAGED
  REJECTED
}

enum LineageType {
  ORIGINAL
  SPLIT
  MERGED
  TRANSFORMED
}

enum ShipmentState {
  CREATED
  IN_TRANSIT
  ARRIVED
  DELIVERED
  REJECTED
  FAILED
}

enum InspectionResult {
  PASS
  FAIL
  CONDITIONAL
}

enum TraceEntityType {
  PRODUCTION_CYCLE
  CARE
  SENSOR
  HARVEST
  LOT
  SHIPMENT
  INSPECTION
  CERTIFICATE
}

enum TraceEventType {
  PRODUCTION_CYCLE_CREATED
  PLANTING_RECORDED
  CARE_RECORDED
  SENSOR_RECORDED
  HARVEST_RECORDED
  PRODUCTION_CYCLE_COMPLETED
  INSPECTION_RECORDED
  CERTIFICATE_ATTACHED
  SHIPMENT_CREATED
  TRANSPORT_STARTED
  TRANSPORT_ARRIVED
  PARTIAL_DAMAGE_RECORDED
  DAMAGE_RECORDED
  RETAIL_RECEIVED
  RETAIL_REJECTED
  MARKED_FOR_SALE
  LOT_SOLD
  RECALL_RECORDED
  LOT_EXPIRED
  ENTITY_CANCELLED
  CORRECTION_RECORDED
}

enum AuthProofType {
  DIGITAL_SIGNATURE
  SIGNED_ASSERTION
  TOKEN_FINGERPRINT
  DEVICE_SIGNATURE
  SYSTEM_ASSERTION
}

enum BlockchainTransactionStatus {
  PENDING
  COMMITTED
  FAILED
}

enum QuantityMovementType {
  HARVEST
  SHIPMENT
  DAMAGE
  RECEIPT
  REJECTION
  SALE
  ADJUSTMENT
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Organization {
  id                   String             @id @default(uuid()) @map("organization_id") @db.Uuid
  name                 String             @db.VarChar(255)
  type                 OrganizationType
  status               OrganizationStatus @default(ACTIVE)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  users                User[]
  farms                Farm[]
  devices              IoTDevice[]
  farmLots             Lot[]              @relation("LotFarmOrganization")
  transportedShipments Shipment[]         @relation("ShipmentTransporter")
  retailerShipments    Shipment[]         @relation("ShipmentRetailer")
  inspections          Inspection[]
  actorTraceEvents     TraceEvent[]       @relation("TraceEventActorOrganization")

  @@map("organizations")
}

model Role {
  id          String  @id @default(uuid()) @map("role_id") @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  users       User[]

  @@map("roles")
}

model User {
  id             String        @id @default(uuid()) @map("user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  roleId         String        @map("role_id") @db.Uuid
  email          String        @unique @db.VarChar(255)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  fullName       String?       @map("full_name") @db.VarChar(255)
  accountStatus  AccountStatus @default(ACTIVE) @map("account_status")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  traceEvents    TraceEvent[]  @relation("TraceEventActorUser")

  @@map("users")
}

model Product {
  id               String            @id @default(uuid()) @map("product_id") @db.Uuid
  productName      String            @map("product_name") @db.VarChar(255)
  variety          String?           @db.VarChar(255)
  defaultUnit      String            @map("default_unit") @db.VarChar(50)
  description      String?           @db.Text
  status           ProductStatus     @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  productionCycles ProductionCycle[]
  lots             Lot[]

  @@index([productName])
  @@map("products")
}

model Farm {
  id               String            @id @default(uuid()) @map("farm_id") @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  name             String            @db.VarChar(255)
  location         String?           @db.Text
  status           FarmStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plots            Plot[]
  productionCycles ProductionCycle[]

  @@index([organizationId])
  @@map("farms")
}

model Plot {
  id               String            @id @default(uuid()) @map("plot_id") @db.Uuid
  farmId           String            @map("farm_id") @db.Uuid
  name             String            @db.VarChar(255)
  area             Decimal?          @db.Decimal(18, 3)
  unit             String?           @db.VarChar(50)
  location         String?           @db.Text
  status           PlotStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  farm             Farm              @relation(fields: [farmId], references: [id], onDelete: Restrict)
  productionCycles ProductionCycle[]

  @@unique([farmId, name])
  @@map("plots")
}

model ProductionCycle {
  id             String               @id @default(uuid()) @map("cycle_id") @db.Uuid
  cycleCode      String               @map("cycle_code") @db.VarChar(100)
  productId      String               @map("product_id") @db.Uuid
  farmId         String               @map("farm_id") @db.Uuid
  plotId         String?              @map("plot_id") @db.Uuid
  startDate      DateTime?            @map("start_date") @db.Timestamptz(3)
  plannedHarvest DateTime?            @map("planned_harvest") @db.Timestamptz(3)
  currentState   ProductionCycleState @default(CREATED) @map("current_state")
  note           String?              @db.Text
  version        Int                  @default(0)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  farm           Farm                 @relation(fields: [farmId], references: [id], onDelete: Restrict)
  plot           Plot?                @relation(fields: [plotId], references: [id], onDelete: Restrict)
  careRecords    CareRecord[]
  devices        IoTDevice[]
  sensorReadings SensorReading[]
  sensorDigests  SensorDigest[]
  harvestEvents  HarvestEvent[]
  certificates   Certificate[]
  traceEvents    TraceEvent[]

  @@unique([farmId, cycleCode])
  @@index([productId])
  @@index([plotId])
  @@map("production_cycles")
}

model CareRecord {
  id               String          @id @default(uuid()) @map("care_id") @db.Uuid
  cycleId          String          @map("cycle_id") @db.Uuid
  careType         CareType        @map("care_type")
  eventTime        DateTime        @map("event_time") @db.Timestamptz(3)
  materialName     String?         @map("material_name") @db.VarChar(255)
  activeIngredient String?         @map("active_ingredient") @db.VarChar(255)
  quantity         Decimal?        @db.Decimal(18, 3)
  unit             String?         @db.VarChar(50)
  withdrawalPeriod Int?            @map("withdrawal_period")
  note             String?         @db.Text
  evidenceRef      String?         @map("evidence_ref") @db.Text
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  cycle            ProductionCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([cycleId, eventTime])
  @@map("care_records")
}

model IoTDevice {
  id             String           @id @default(uuid()) @map("device_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  cycleId        String?          @map("cycle_id") @db.Uuid
  deviceCode     String           @unique @map("device_code") @db.VarChar(100)
  name           String?          @db.VarChar(255)
  type           DeviceType
  status         DeviceStatus     @default(ACTIVE)
  lastSeenAt     DateTime?        @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cycle          ProductionCycle? @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  sensorReadings SensorReading[]

  @@index([cycleId])
  @@map("iot_devices")
}

model SensorReading {
  id         String          @id @default(uuid()) @map("reading_id") @db.Uuid
  deviceId   String          @map("device_id") @db.Uuid
  cycleId    String          @map("cycle_id") @db.Uuid
  sensorType String          @map("sensor_type") @db.VarChar(100)
  value      Decimal         @db.Decimal(18, 6)
  unit       String          @db.VarChar(50)
  timestamp  DateTime        @db.Timestamptz(3)
  ingestTime DateTime        @default(now()) @map("ingest_time") @db.Timestamptz(3)
  device     IoTDevice       @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  cycle      ProductionCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([cycleId, timestamp])
  @@index([deviceId, timestamp])
  @@map("sensor_readings")
}

model SensorDigest {
  id           String          @id @default(uuid()) @map("digest_id") @db.Uuid
  cycleId      String          @map("cycle_id") @db.Uuid
  periodStart  DateTime        @map("period_start") @db.Timestamptz(3)
  periodEnd    DateTime        @map("period_end") @db.Timestamptz(3)
  readingCount Int             @map("reading_count")
  digestHash   String          @map("digest_hash") @db.Char(64)
  isFinal      Boolean         @default(false) @map("is_final")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  cycle        ProductionCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  harvestEvent HarvestEvent?

  @@index([cycleId, periodStart, periodEnd])
  @@map("sensor_digests")
}

model HarvestEvent {
  id                  String          @id @default(uuid()) @map("harvest_id") @db.Uuid
  cycleId             String          @map("cycle_id") @db.Uuid
  finalSensorDigestId String?         @unique @map("final_sensor_digest_id") @db.Uuid
  harvestTime         DateTime        @map("harvest_time") @db.Timestamptz(3)
  quantity            Decimal         @db.Decimal(18, 3)
  unit                String          @db.VarChar(50)
  qualityNote         String?         @map("quality_note") @db.Text
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  cycle               ProductionCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  finalSensorDigest   SensorDigest?   @relation(fields: [finalSensorDigestId], references: [id], onDelete: Restrict)
  lot                 Lot?

  @@index([cycleId, harvestTime])
  @@map("harvest_events")
}

model Lot {
  id                String             @id @default(uuid()) @map("lot_id") @db.Uuid
  lotCode           String             @unique @map("lot_code") @db.VarChar(100)
  harvestId         String             @unique @map("harvest_id") @db.Uuid
  productId         String             @map("product_id") @db.Uuid
  farmOrgId         String             @map("farm_org_id") @db.Uuid
  initialQuantity   Decimal            @map("initial_quantity") @db.Decimal(18, 3)
  availableQuantity Decimal            @map("available_quantity") @db.Decimal(18, 3)
  unit              String             @db.VarChar(50)
  currentState      LotState           @default(HARVESTED) @map("current_state")
  parentLotId       String?            @map("parent_lot_id") @db.Uuid
  lineageType       LineageType        @default(ORIGINAL) @map("lineage_type")
  version           Int                @default(0)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  harvest           HarvestEvent       @relation(fields: [harvestId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  farmOrganization  Organization       @relation("LotFarmOrganization", fields: [farmOrgId], references: [id], onDelete: Restrict)
  parentLot         Lot?               @relation("LotLineage", fields: [parentLotId], references: [id], onDelete: Restrict)
  childLots         Lot[]              @relation("LotLineage")
  shipment          Shipment?
  quantityMovements QuantityMovement[]
  inspections       Inspection[]
  certificates      Certificate[]
  traceQr           TraceQR?
  traceEvents       TraceEvent[]

  @@index([farmOrgId, currentState])
  @@index([productId])
  @@map("lots")
}

model Shipment {
  id                  String        @id @default(uuid()) @map("shipment_id") @db.Uuid
  lotId               String        @unique @map("lot_id") @db.Uuid
  transporterOrgId    String        @map("transporter_org_id") @db.Uuid
  retailerOrgId       String        @map("retailer_org_id") @db.Uuid
  origin              String        @db.Text
  destination         String        @db.Text
  shippedQuantity     Decimal       @map("shipped_quantity") @db.Decimal(18, 3)
  unit                String        @db.VarChar(50)
  plannedPickupTime   DateTime?     @map("planned_pickup_time") @db.Timestamptz(3)
  expectedArrivalTime DateTime?     @map("expected_arrival_time") @db.Timestamptz(3)
  pickupTime          DateTime?     @map("pickup_time") @db.Timestamptz(3)
  arrivalTime         DateTime?     @map("arrival_time") @db.Timestamptz(3)
  receivedTime        DateTime?     @map("received_time") @db.Timestamptz(3)
  receivedQuantity    Decimal?      @map("received_quantity") @db.Decimal(18, 3)
  rejectedQuantity    Decimal?      @map("rejected_quantity") @db.Decimal(18, 3)
  rejectReason        String?       @map("reject_reason") @db.Text
  status              ShipmentState @default(CREATED)
  version             Int           @default(0)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  lot                 Lot           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  transporterOrg      Organization  @relation("ShipmentTransporter", fields: [transporterOrgId], references: [id], onDelete: Restrict)
  retailerOrg         Organization  @relation("ShipmentRetailer", fields: [retailerOrgId], references: [id], onDelete: Restrict)

  @@index([transporterOrgId, status])
  @@index([retailerOrgId, status])
  @@map("shipments")
}

model TraceEvent {
  id                      String             @id @default(uuid()) @map("event_id") @db.Uuid
  entityType              TraceEntityType    @map("entity_type")
  entityId                String             @map("entity_id") @db.Uuid
  cycleId                 String?            @map("cycle_id") @db.Uuid
  lotId                   String?            @map("lot_id") @db.Uuid
  eventType               TraceEventType     @map("event_type")
  actorUserId             String?            @map("actor_user_id") @db.Uuid
  actorOrganizationId     String?            @map("actor_organization_id") @db.Uuid
  actorRole               String             @map("actor_role") @db.VarChar(50)
  authProofType           AuthProofType      @map("auth_proof_type")
  actorAuthProof          String             @map("actor_auth_proof") @db.Text
  eventTime               DateTime           @map("event_time") @db.Timestamptz(3)
  serverRecordedAt        DateTime           @default(now()) @map("server_recorded_at") @db.Timestamptz(3)
  businessData            Json               @map("business_data") @db.JsonB
  schemaVersion           String             @map("schema_version") @db.VarChar(50)
  canonicalizationVersion String             @map("canonicalization_version") @db.VarChar(50)
  dataHash                String             @map("data_hash") @db.Char(64)
  previousEventHash       String?            @map("previous_event_hash") @db.Char(64)
  supersedesEventId       String?            @map("supersedes_event_id") @db.Uuid
  causationEventId        String?            @map("causation_event_id") @db.Uuid
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  cycle                   ProductionCycle?   @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  lot                     Lot?               @relation(fields: [lotId], references: [id], onDelete: Restrict)
  actorUser               User?              @relation("TraceEventActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorOrganization       Organization?      @relation("TraceEventActorOrganization", fields: [actorOrganizationId], references: [id], onDelete: Restrict)
  supersedesEvent         TraceEvent?        @relation("TraceEventSupersession", fields: [supersedesEventId], references: [id], onDelete: Restrict)
  supersededByEvents      TraceEvent[]       @relation("TraceEventSupersession")
  causationEvent          TraceEvent?        @relation("TraceEventCausation", fields: [causationEventId], references: [id], onDelete: Restrict)
  causedEvents            TraceEvent[]       @relation("TraceEventCausation")
  blockchainProof         BlockchainProof?
  quantityMovements       QuantityMovement[]

  @@index([entityType, entityId, eventTime])
  @@index([cycleId, eventTime])
  @@index([lotId, eventTime])
  @@map("trace_events")
}

model BlockchainProof {
  id                String                      @id @default(uuid()) @map("proof_id") @db.Uuid
  eventId           String                      @unique @map("event_id") @db.Uuid
  network           String                      @db.VarChar(100)
  txId              String?                     @unique @map("tx_id") @db.VarChar(255)
  dataHash          String                      @map("data_hash") @db.Char(64)
  recordedAt        DateTime?                   @map("recorded_at") @db.Timestamptz(3)
  relayerAddress    String?                     @map("relayer_address") @db.VarChar(255)
  transactionStatus BlockchainTransactionStatus @default(PENDING) @map("transaction_status")
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  traceEvent        TraceEvent                  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("blockchain_proofs")
}

model QuantityMovement {
  id        String               @id @default(uuid()) @map("movement_id") @db.Uuid
  lotId     String               @map("lot_id") @db.Uuid
  eventId   String               @map("event_id") @db.Uuid
  type      QuantityMovementType
  quantity  Decimal              @db.Decimal(18, 3)
  unit      String               @db.VarChar(50)
  beforeQty Decimal              @map("before_qty") @db.Decimal(18, 3)
  delta     Decimal              @db.Decimal(18, 3)
  afterQty  Decimal              @map("after_qty") @db.Decimal(18, 3)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lot       Lot                  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  event     TraceEvent           @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([lotId, createdAt])
  @@index([eventId])
  @@map("quantity_movements")
}

model Inspection {
  id             String           @id @default(uuid()) @map("inspection_id") @db.Uuid
  lotId          String           @map("lot_id") @db.Uuid
  inspectorOrgId String?          @map("inspector_org_id") @db.Uuid
  result         InspectionResult
  note           String?          @db.Text
  inspectedAt    DateTime         @map("inspected_at") @db.Timestamptz(3)
  evidenceRef    String?          @map("evidence_ref") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  lot            Lot              @relation(fields: [lotId], references: [id], onDelete: Restrict)
  inspectorOrg   Organization?    @relation(fields: [inspectorOrgId], references: [id], onDelete: Restrict)

  @@index([lotId, inspectedAt])
  @@map("inspections")
}

model Certificate {
  id           String           @id @default(uuid()) @map("certificate_id") @db.Uuid
  lotId        String?          @map("lot_id") @db.Uuid
  cycleId      String?          @map("cycle_id") @db.Uuid
  type         String           @db.VarChar(100)
  issuer       String           @db.VarChar(255)
  issueDate    DateTime         @map("issue_date") @db.Date
  expiryDate   DateTime?        @map("expiry_date") @db.Date
  documentRef  String           @map("document_ref") @db.Text
  documentHash String           @map("document_hash") @db.Char(64)
  isPublic     Boolean          @default(false) @map("is_public")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  lot          Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  cycle        ProductionCycle? @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([lotId])
  @@index([cycleId])
  @@map("certificates")
}

model TraceQR {
  id         String   @id @default(uuid()) @map("trace_qr_id") @db.Uuid
  lotId      String   @unique @map("lot_id") @db.Uuid
  traceToken String   @unique @map("trace_token") @db.VarChar(255)
  traceUrl   String   @map("trace_url") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lot        Lot      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@map("trace_qr_codes")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @map("idempotency_record_id") @db.Uuid
  idempotencyKey String            @map("idempotency_key") @db.VarChar(255)
  operation      String            @db.VarChar(100)
  requestType    String            @map("request_type") @db.VarChar(50)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body") @db.JsonB
  resourceId     String?           @map("resource_id") @db.Uuid
  requesterId    String            @map("requester_id") @db.VarChar(255)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)

  @@unique([requesterId, operation, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}
