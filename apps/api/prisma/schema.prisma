generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(120)
  description String?
  users       User[]

  @@map("app_role")
}

model User {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  organizationId   String?                   @map("organization_id") @db.Uuid
  roleId           String                    @map("role_id") @db.Uuid
  email            String                    @db.VarChar(255)
  passwordHash     String                    @map("password_hash")
  fullName         String                    @map("full_name") @db.VarChar(255)
  accountStatus    AccountStatus             @default(ACTIVE) @map("account_status")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization     Organization?             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role             Role                      @relation(fields: [roleId], references: [id], onUpdate: NoAction)
  trackingBindings ShipmentTrackingBinding[]
  traceEvents      TraceEvent[]
  refreshSessions  RefreshSession[]

  @@map("app_user")
}

model RefreshSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @map("refresh_session_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, revokedAt], map: "ix_refresh_session_user_active")
  @@index([expiresAt], map: "ix_refresh_session_expiry")
  @@map("refresh_session")
}

model Organization {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @map("organization_id") @db.Uuid
  name                   String                    @db.VarChar(255)
  type                   OrganizationType
  status                 OrganizationStatus        @default(ACTIVE)
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  users                  User[]
  farms                  Farm[]
  inspections            Inspection[]
  devices                IotDevice[]
  lots                   Lot[]
  productionCycles       ProductionCycle[]
  shipmentsAsRetailer    Shipment[]                @relation("ShipmentRetailer")
  shipmentsAsTransporter Shipment[]                @relation("ShipmentTransporter")
  trackingBindings       ShipmentTrackingBinding[]
  traceEvents            TraceEvent[]

  @@map("organization")
}

model Farm {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @map("farm_id") @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String             @db.VarChar(255)
  location       String?
  status         OrganizationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onUpdate: NoAction)
  plots          Plot[]
  cycles         ProductionCycle[]

  @@index([organizationId], map: "ix_farm_organization")
  @@map("farm")
}

model Plot {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @map("plot_id") @db.Uuid
  farmId    String             @map("farm_id") @db.Uuid
  name      String             @db.VarChar(255)
  area      Decimal?           @db.Decimal(12, 2)
  unit      String?            @db.VarChar(30)
  location  String?
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  farm      Farm               @relation(fields: [farmId], references: [id], onUpdate: NoAction)
  cycles    ProductionCycle[]

  @@unique([farmId, name], map: "uq_plot_farm_name")
  @@index([farmId], map: "ix_plot_farm")
  @@map("plot")
}

model Product {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @map("product_id") @db.Uuid
  productName String             @map("product_name") @db.VarChar(255)
  variety     String?            @db.VarChar(255)
  defaultUnit String?            @map("default_unit") @db.VarChar(30)
  description String?
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  lots        Lot[]
  cycles      ProductionCycle[]

  @@map("product")
}

model ProductionCycle {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @map("cycle_id") @db.Uuid
  cycleCode          String               @map("cycle_code") @db.VarChar(100)
  productId          String               @map("product_id") @db.Uuid
  farmId             String               @map("farm_id") @db.Uuid
  farmOrgId          String               @map("farm_org_id") @db.Uuid
  plotId             String?              @map("plot_id") @db.Uuid
  startDate          DateTime?            @map("start_date") @db.Date
  plannedHarvest     DateTime?            @map("planned_harvest") @db.Date
  maxHarvestQuantity Decimal?             @map("max_harvest_quantity") @db.Decimal(14, 3)
  harvestUnit        String?              @map("harvest_unit") @db.VarChar(30)
  currentState       ProductionCycleState @default(CREATED) @map("current_state")
  note               String?
  version            Int                  @default(0)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  careRecords        CareRecord[]
  certificates       Certificate[]
  harvestEvents      HarvestEvent[]
  devices            IotDevice[]
  farm               Farm                 @relation(fields: [farmId], references: [id], onUpdate: NoAction)
  organization       Organization         @relation(fields: [farmOrgId], references: [id], onUpdate: NoAction)
  plot               Plot?                @relation(fields: [plotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product            Product              @relation(fields: [productId], references: [id], onUpdate: NoAction)
  sensorDigests      SensorDigest[]
  sensorReadings     SensorReading[]
  traceEvents        TraceEvent[]

  @@unique([farmId, cycleCode], map: "uq_production_cycle_farm_code")
  @@index([farmOrgId], map: "ix_production_cycle_farm_org")
  @@index([productId], map: "ix_production_cycle_product")
  @@index([currentState], map: "ix_production_cycle_state")
  @@map("production_cycle")
}

model CareRecord {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @map("care_id") @db.Uuid
  cycleId          String          @map("cycle_id") @db.Uuid
  careType         String          @map("care_type") @db.VarChar(100)
  eventTime        DateTime        @map("event_time") @db.Timestamptz(6)
  materialName     String?         @map("material_name") @db.VarChar(255)
  activeIngredient String?         @map("active_ingredient") @db.VarChar(255)
  quantity         Decimal?        @db.Decimal(14, 4)
  unit             String?         @db.VarChar(30)
  method           String?         @db.VarChar(255)
  applicationArea  String?         @map("application_area") @db.VarChar(255)
  withdrawalPeriod Int?            @map("withdrawal_period")
  note             String?
  evidenceRef      String?         @map("evidence_ref")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  cycle            ProductionCycle @relation(fields: [cycleId], references: [id], onUpdate: NoAction)

  @@index([cycleId, eventTime], map: "ix_care_record_cycle_time")
  @@map("care_record")
}

model IotDevice {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @map("device_id") @db.Uuid
  organizationId           String                    @map("organization_id") @db.Uuid
  cycleId                  String?                   @map("cycle_id") @db.Uuid
  deviceCode               String                    @unique @map("device_code") @db.VarChar(120)
  name                     String                    @db.VarChar(255)
  type                     String                    @db.VarChar(100)
  status                   DeviceStatus              @default(ACTIVE)
  lastSeenAt               DateTime?                 @map("last_seen_at") @db.Timestamptz(6)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  cycle                    ProductionCycle?          @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organization             Organization              @relation(fields: [organizationId], references: [id], onUpdate: NoAction)
  sensorReadings           SensorReading[]
  shipmentTelemetry        ShipmentTelemetry[]
  shipmentTelemetryDigests ShipmentTelemetryDigest[]
  trackingBinding          ShipmentTrackingBinding?

  @@index([cycleId], map: "ix_iot_device_cycle")
  @@index([organizationId], map: "ix_iot_device_org")
  @@map("iot_device")
}

model SensorReading {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @map("reading_id") @db.Uuid
  deviceId   String          @map("device_id") @db.Uuid
  cycleId    String          @map("cycle_id") @db.Uuid
  sensorType String          @map("sensor_type") @db.VarChar(100)
  value      Decimal         @db.Decimal(16, 6)
  unit       String          @db.VarChar(30)
  recordedAt DateTime        @map("recorded_at") @db.Timestamptz(6)
  ingestTime DateTime        @default(now()) @map("ingest_time") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  cycle      ProductionCycle @relation(fields: [cycleId], references: [id], onUpdate: NoAction)
  device     IotDevice       @relation(fields: [deviceId], references: [id], onUpdate: NoAction)

  @@index([cycleId, recordedAt], map: "ix_sensor_reading_cycle_time")
  @@index([deviceId, recordedAt], map: "ix_sensor_reading_device_time")
  @@map("sensor_reading")
}

model SensorDigest {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @map("digest_id") @db.Uuid
  cycleId                 String          @map("cycle_id") @db.Uuid
  periodStart             DateTime        @map("period_start") @db.Timestamptz(6)
  periodEnd               DateTime        @map("period_end") @db.Timestamptz(6)
  readingCount            Int             @map("reading_count")
  digestHash              String          @map("digest_hash") @db.VarChar(64)
  schemaVersion           String          @default("sensor-digest-1") @map("schema_version") @db.VarChar(50)
  canonicalizationVersion String          @default("RFC8785-JCS-v1") @map("canonicalization_version") @db.VarChar(50)
  isFinal                 Boolean         @default(false) @map("is_final")
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  harvestEvent            HarvestEvent?
  cycle                   ProductionCycle @relation(fields: [cycleId], references: [id], onUpdate: NoAction)

  @@index([cycleId, periodStart, periodEnd], map: "ix_sensor_digest_cycle_period")
  @@index([digestHash], map: "ix_sensor_digest_hash")
  @@map("sensor_digest")
}

model HarvestEvent {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @map("harvest_id") @db.Uuid
  cycleId             String          @map("cycle_id") @db.Uuid
  finalSensorDigestId String?         @unique @map("final_sensor_digest_id") @db.Uuid
  harvestTime         DateTime        @map("harvest_time") @db.Timestamptz(6)
  quantity            Decimal         @db.Decimal(14, 3)
  unit                String          @db.VarChar(30)
  qualityNote         String?         @map("quality_note")
  grade               String?         @db.VarChar(100)
  harvestArea         String?         @map("harvest_area") @db.VarChar(255)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  cycle               ProductionCycle @relation(fields: [cycleId], references: [id], onUpdate: NoAction)
  finalSensorDigest   SensorDigest?   @relation(fields: [finalSensorDigestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lot                 Lot?

  @@index([cycleId, harvestTime], map: "ix_harvest_cycle_time")
  @@map("harvest_event")
}

model Lot {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @map("lot_id") @db.Uuid
  lotCode           String             @unique @map("lot_code") @db.VarChar(120)
  harvestId         String             @unique @map("harvest_id") @db.Uuid
  productId         String             @map("product_id") @db.Uuid
  farmOrgId         String             @map("farm_org_id") @db.Uuid
  initialQuantity   Decimal            @map("initial_quantity") @db.Decimal(14, 3)
  availableQuantity Decimal            @map("available_quantity") @db.Decimal(14, 3)
  unit              String             @db.VarChar(30)
  grade             String?            @db.VarChar(100)
  expiryDate        DateTime?          @map("expiry_date") @db.Date
  currentState      LotState           @default(HARVESTED) @map("current_state")
  parentLotId       String?            @map("parent_lot_id") @db.Uuid
  lineageType       String?            @map("lineage_type") @db.VarChar(100)
  version           Int                @default(0)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  certificates      Certificate[]
  inspections       Inspection[]
  organization      Organization       @relation(fields: [farmOrgId], references: [id], onUpdate: NoAction)
  harvest           HarvestEvent       @relation(fields: [harvestId], references: [id], onUpdate: NoAction)
  parentLot         Lot?               @relation("LotLineage", fields: [parentLotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  childLots         Lot[]              @relation("LotLineage")
  product           Product            @relation(fields: [productId], references: [id], onUpdate: NoAction)
  quantityMovements QuantityMovement[]
  shipment          Shipment?
  traceEvents       TraceEvent[]
  traceQr           TraceQr?

  @@index([farmOrgId], map: "ix_lot_farm_org")
  @@index([productId], map: "ix_lot_product")
  @@index([currentState], map: "ix_lot_state")
  @@map("lot")
}

model Shipment {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @map("shipment_id") @db.Uuid
  lotId             String                    @unique @map("lot_id") @db.Uuid
  transporterOrgId  String                    @map("transporter_org_id") @db.Uuid
  retailerOrgId     String                    @map("retailer_org_id") @db.Uuid
  origin            String
  destination       String
  shippedQuantity   Decimal                   @map("shipped_quantity") @db.Decimal(14, 3)
  unit              String                    @db.VarChar(30)
  plannedPickupTime DateTime?                 @map("planned_pickup_time") @db.Timestamptz(6)
  expectedArrival   DateTime?                 @map("expected_arrival_time") @db.Timestamptz(6)
  pickupTime        DateTime?                 @map("pickup_time") @db.Timestamptz(6)
  arrivalTime       DateTime?                 @map("arrival_time") @db.Timestamptz(6)
  receivedTime      DateTime?                 @map("received_time") @db.Timestamptz(6)
  receivedQuantity  Decimal?                  @map("received_quantity") @db.Decimal(14, 3)
  rejectedQuantity  Decimal?                  @map("rejected_quantity") @db.Decimal(14, 3)
  rejectReason      String?                   @map("reject_reason")
  vehicleRef        String?                   @map("vehicle_ref") @db.VarChar(255)
  conditions        Json?
  status            ShipmentState             @default(CREATED)
  version           Int                       @default(0)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  lot               Lot                       @relation(fields: [lotId], references: [id], onUpdate: NoAction)
  retailer          Organization              @relation("ShipmentRetailer", fields: [retailerOrgId], references: [id], onUpdate: NoAction)
  transporter       Organization              @relation("ShipmentTransporter", fields: [transporterOrgId], references: [id], onUpdate: NoAction)
  telemetry         ShipmentTelemetry[]
  telemetryDigest   ShipmentTelemetryDigest?
  trackingBindings  ShipmentTrackingBinding[]

  @@index([retailerOrgId], map: "ix_shipment_retailer")
  @@index([status], map: "ix_shipment_status")
  @@index([transporterOrgId], map: "ix_shipment_transporter")
  @@map("shipment")
}

model ShipmentTrackingBinding {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @map("binding_id") @db.Uuid
  shipmentId       String              @map("shipment_id") @db.Uuid
  deviceId         String              @unique(map: "ux_tracking_binding_active_device", where: raw("((unbound_at IS NULL) AND ((status)::text = 'ACTIVE'::text))")) @map("device_id") @db.Uuid
  transporterOrgId String              @map("transporter_org_id") @db.Uuid
  boundAt          DateTime            @default(now()) @map("bound_at") @db.Timestamptz(6)
  unboundAt        DateTime?           @map("unbound_at") @db.Timestamptz(6)
  status           String              @default("ACTIVE") @db.VarChar(30)
  boundBy          String?             @map("bound_by") @db.Uuid
  note             String?
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  telemetry        ShipmentTelemetry[]
  user             User?               @relation(fields: [boundBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  device           IotDevice           @relation(fields: [deviceId], references: [id], onUpdate: NoAction)
  shipment         Shipment            @relation(fields: [shipmentId], references: [id], onUpdate: NoAction)
  organization     Organization        @relation(fields: [transporterOrgId], references: [id], onUpdate: NoAction)

  @@index([deviceId], map: "ix_tracking_binding_device")
  @@index([shipmentId], map: "ix_tracking_binding_shipment")
  @@map("shipment_tracking_binding")
}

model ShipmentTelemetry {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @map("telemetry_id") @db.Uuid
  shipmentId     String                  @map("shipment_id") @db.Uuid
  deviceId       String                  @map("device_id") @db.Uuid
  bindingId      String                  @map("binding_id") @db.Uuid
  deviceSequence BigInt?                 @map("device_sequence")
  idempotencyKey String?                 @map("idempotency_key") @db.VarChar(150)
  latitude       Decimal                 @db.Decimal(9, 6)
  longitude      Decimal                 @db.Decimal(9, 6)
  accuracy       Decimal?                @db.Decimal(10, 3)
  speed          Decimal?                @db.Decimal(12, 3)
  heading        Decimal?                @db.Decimal(7, 3)
  temperature    Decimal?                @db.Decimal(10, 3)
  humidity       Decimal?                @db.Decimal(10, 3)
  battery        Decimal?                @db.Decimal(6, 2)
  recordedAt     DateTime                @map("recorded_at") @db.Timestamptz(6)
  ingestTime     DateTime                @default(now()) @map("ingest_time") @db.Timestamptz(6)
  validityStatus String?                 @map("validity_status") @db.VarChar(30)
  anomalyNote    String?                 @map("anomaly_note")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  binding        ShipmentTrackingBinding @relation(fields: [bindingId], references: [id], onUpdate: NoAction)
  device         IotDevice               @relation(fields: [deviceId], references: [id], onUpdate: NoAction)
  shipment       Shipment                @relation(fields: [shipmentId], references: [id], onUpdate: NoAction)

  @@unique([deviceId, deviceSequence], map: "ux_shipment_telemetry_device_sequence", where: raw("(device_sequence IS NOT NULL)"))
  @@unique([deviceId, idempotencyKey], map: "ux_shipment_telemetry_idempotency", where: raw("(idempotency_key IS NOT NULL)"))
  @@index([deviceId, recordedAt], map: "ix_shipment_telemetry_device_time")
  @@index([ingestTime], map: "ix_shipment_telemetry_ingest_time")
  @@index([shipmentId, recordedAt], map: "ix_shipment_telemetry_shipment_time")
  @@index([validityStatus], map: "ix_shipment_telemetry_validity")
  @@map("shipment_telemetry")
}

model ShipmentTelemetryDigest {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @map("digest_id") @db.Uuid
  shipmentId              String     @unique(map: "ux_tracking_digest_final_shipment", where: raw("(is_final = true)")) @map("shipment_id") @db.Uuid
  deviceId                String?    @map("device_id") @db.Uuid
  periodStart             DateTime   @map("period_start") @db.Timestamptz(6)
  periodEnd               DateTime   @map("period_end") @db.Timestamptz(6)
  readingCount            Int        @map("reading_count")
  firstLatitude           Decimal?   @map("first_latitude") @db.Decimal(9, 6)
  firstLongitude          Decimal?   @map("first_longitude") @db.Decimal(9, 6)
  lastLatitude            Decimal?   @map("last_latitude") @db.Decimal(9, 6)
  lastLongitude           Decimal?   @map("last_longitude") @db.Decimal(9, 6)
  conditionSummary        Json?      @map("condition_summary")
  anomalySummary          Json?      @map("anomaly_summary")
  digestHash              String     @map("digest_hash") @db.VarChar(64)
  previousDigestHash      String?    @map("previous_digest_hash") @db.VarChar(64)
  schemaVersion           String     @default("shipment-telemetry-digest-1") @map("schema_version") @db.VarChar(50)
  canonicalizationVersion String     @default("RFC8785-JCS-v1") @map("canonicalization_version") @db.VarChar(50)
  isFinal                 Boolean    @default(false) @map("is_final")
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  device                  IotDevice? @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  shipment                Shipment   @relation(fields: [shipmentId], references: [id], onUpdate: NoAction)

  @@unique([shipmentId, periodStart, periodEnd], map: "uq_tracking_digest_window")
  @@index([digestHash], map: "ix_tracking_digest_hash")
  @@index([shipmentId, periodStart, periodEnd], map: "ix_tracking_digest_shipment_period")
  @@map("shipment_telemetry_digest")
}

model TraceEvent {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  entityType              String             @map("entity_type") @db.VarChar(50)
  entityId                String             @map("entity_id") @db.Uuid
  cycleId                 String?            @map("cycle_id") @db.Uuid
  lotId                   String?            @map("lot_id") @db.Uuid
  eventType               String             @map("event_type") @db.VarChar(100)
  actorUserId             String?            @map("actor_user_id") @db.Uuid
  actorOrganizationId     String?            @map("actor_organization_id") @db.Uuid
  actorRole               String             @map("actor_role") @db.VarChar(50)
  authProofType           String?            @map("auth_proof_type") @db.VarChar(100)
  actorAuthProof          String?            @map("actor_auth_proof")
  eventTime               DateTime           @map("event_time") @db.Timestamptz(6)
  serverRecordedAt        DateTime           @default(now()) @map("server_recorded_at") @db.Timestamptz(6)
  businessData            Json               @map("business_data")
  schemaVersion           String             @default("2.0.0") @map("schema_version") @db.VarChar(50)
  canonicalizationVersion String             @default("RFC8785") @map("canonicalization_version") @db.VarChar(50)
  dataHash                String             @map("data_hash") @db.VarChar(64)
  previousEventHash       String?            @map("previous_event_hash") @db.VarChar(64)
  supersedesEventId       String?            @map("supersedes_event_id") @db.Uuid
  causationEventId        String?            @map("causation_event_id") @db.Uuid
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  blockchainProof         BlockchainProof?
  quantityMovements       QuantityMovement[]
  organization            Organization?      @relation(fields: [actorOrganizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor                   User?              @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  causationEvent          TraceEvent?        @relation("TraceCausation", fields: [causationEventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  causedEvents            TraceEvent[]       @relation("TraceCausation")
  cycle                   ProductionCycle?   @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lot                     Lot?               @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersededEvent         TraceEvent?        @relation("TraceSupersession", fields: [supersedesEventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersedingEvents       TraceEvent[]       @relation("TraceSupersession")

  @@index([cycleId, eventTime], map: "ix_trace_event_cycle_time")
  @@index([entityType, entityId], map: "ix_trace_event_entity")
  @@index([dataHash], map: "ix_trace_event_hash")
  @@index([lotId, eventTime], map: "ix_trace_event_lot_time")
  @@index([eventType], map: "ix_trace_event_type")
  @@map("trace_event")
}

model BlockchainProof {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @map("proof_id") @db.Uuid
  eventId           String                      @unique @map("event_id") @db.Uuid
  network           String                      @db.VarChar(100)
  channelId         String                      @default("agritrace") @map("channel_id") @db.VarChar(100)
  txId              String?                     @unique @map("tx_id") @db.VarChar(255)
  dataHash          String                      @map("data_hash") @db.VarChar(64)
  recordedAt        DateTime?                   @map("recorded_at") @db.Timestamptz(6)
  relayerAddress    String?                     @map("relayer_address") @db.VarChar(255)
  transactionStatus BlockchainTransactionStatus @default(PENDING) @map("transaction_status")
  attemptCount      Int                         @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?                   @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String?                     @map("last_error")
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  traceEvent        TraceEvent                  @relation(fields: [eventId], references: [id], onUpdate: NoAction)

  @@index([dataHash], map: "ix_blockchain_proof_hash")
  @@index([transactionStatus, nextAttemptAt], map: "ix_blockchain_proof_status")
  @@map("blockchain_proof")
}

model QuantityMovement {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @map("movement_id") @db.Uuid
  lotId      String     @map("lot_id") @db.Uuid
  eventId    String     @map("event_id") @db.Uuid
  type       String     @db.VarChar(50)
  quantity   Decimal    @db.Decimal(14, 3)
  unit       String     @db.VarChar(30)
  beforeQty  Decimal    @map("before_qty") @db.Decimal(14, 3)
  delta      Decimal    @db.Decimal(14, 3)
  afterQty   Decimal    @map("after_qty") @db.Decimal(14, 3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  traceEvent TraceEvent @relation(fields: [eventId], references: [id], onUpdate: NoAction)
  lot        Lot        @relation(fields: [lotId], references: [id], onUpdate: NoAction)

  @@index([eventId], map: "ix_quantity_movement_event")
  @@index([lotId, createdAt], map: "ix_quantity_movement_lot_time")
  @@map("quantity_movement")
}

model Certificate {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @map("certificate_id") @db.Uuid
  lotId        String?          @map("lot_id") @db.Uuid
  cycleId      String?          @map("cycle_id") @db.Uuid
  type         String           @db.VarChar(120)
  issuer       String           @db.VarChar(255)
  issueDate    DateTime         @map("issue_date") @db.Date
  expiryDate   DateTime?        @map("expiry_date") @db.Date
  documentRef  String           @map("document_ref")
  documentHash String           @map("document_hash") @db.VarChar(128)
  isPublic     Boolean          @default(false) @map("is_public")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  cycle        ProductionCycle? @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lot          Lot?             @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([cycleId], map: "ix_certificate_cycle")
  @@index([lotId], map: "ix_certificate_lot")
  @@map("certificate")
}

model Inspection {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @map("inspection_id") @db.Uuid
  lotId          String           @map("lot_id") @db.Uuid
  inspectorOrgId String?          @map("inspector_org_id") @db.Uuid
  result         InspectionResult
  note           String?
  inspectedAt    DateTime         @map("inspected_at") @db.Timestamptz(6)
  evidenceRef    String?          @map("evidence_ref")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization?    @relation(fields: [inspectorOrgId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lot            Lot              @relation(fields: [lotId], references: [id], onUpdate: NoAction)

  @@index([lotId, inspectedAt], map: "ix_inspection_lot_time")
  @@map("inspection")
}

model TraceQr {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @map("trace_qr_id") @db.Uuid
  lotId      String   @unique @map("lot_id") @db.Uuid
  traceToken String   @unique @map("trace_token") @db.VarChar(255)
  traceUrl   String   @map("trace_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lot        Lot      @relation(fields: [lotId], references: [id], onUpdate: NoAction)

  @@map("trace_qr")
}

model IdempotencyRecord {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @map("idempotency_record_id") @db.Uuid
  idempotencyKey String            @map("idempotency_key") @db.VarChar(255)
  operation      String            @db.VarChar(100)
  requestType    String            @map("request_type") @db.VarChar(100)
  requestHash    String            @map("request_hash") @db.VarChar(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  resourceId     String?           @map("resource_id") @db.VarChar(255)
  requesterId    String            @map("requester_id") @db.VarChar(255)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  expiresAt      DateTime?         @map("expires_at") @db.Timestamptz(6)

  @@unique([requesterId, operation, idempotencyKey], map: "uq_idempotency_request")
  @@index([expiresAt], map: "ix_idempotency_expires")
  @@index([status], map: "ix_idempotency_status")
  @@map("idempotency_record")
}

