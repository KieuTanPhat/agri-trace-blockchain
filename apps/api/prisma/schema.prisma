generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(120)
  description String?
  users       User[]

  @@map("app_role")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  organizationId   String?                     @map("organization_id") @db.Uuid
  roleId           String                      @map("role_id") @db.Uuid
  email            String                      @db.VarChar(255)
  passwordHash     String                      @map("password_hash")
  fullName         String                      @map("full_name") @db.VarChar(255)
  accountStatus    account_status              @default(ACTIVE) @map("account_status")
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization     organization?               @relation(fields: [organizationId], references: [organization_id], onDelete: Restrict, onUpdate: NoAction)
  role             Role                        @relation(fields: [roleId], references: [id], onUpdate: NoAction)
  trackingBindings shipment_tracking_binding[]
  traceEvents      trace_event[]

  @@map("app_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model blockchain_proof {
  proof_id           String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id           String                        @unique @db.Uuid
  network            String                        @db.VarChar(100)
  tx_id              String?                       @unique @db.VarChar(255)
  data_hash          String                        @db.VarChar(64)
  recorded_at        DateTime?                     @db.Timestamptz(6)
  relayer_address    String?                       @db.VarChar(255)
  transaction_status blockchain_transaction_status @default(PENDING)
  created_at         DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                      @default(now()) @db.Timestamptz(6)
  trace_event        trace_event                   @relation(fields: [event_id], references: [event_id], onUpdate: NoAction)

  @@index([data_hash], map: "ix_blockchain_proof_hash")
  @@index([transaction_status], map: "ix_blockchain_proof_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model care_record {
  care_id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycle_id          String           @db.Uuid
  care_type         String           @db.VarChar(100)
  event_time        DateTime         @db.Timestamptz(6)
  material_name     String?          @db.VarChar(255)
  active_ingredient String?          @db.VarChar(255)
  quantity          Decimal?         @db.Decimal(14, 4)
  unit              String?          @db.VarChar(30)
  method            String?          @db.VarChar(255)
  application_area  String?          @db.VarChar(255)
  withdrawal_period Int?
  note              String?
  evidence_ref      String?
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  production_cycle  production_cycle @relation(fields: [cycle_id], references: [cycle_id], onUpdate: NoAction)

  @@index([cycle_id, event_time], map: "ix_care_record_cycle_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model certificate {
  certificate_id   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lot_id           String?           @db.Uuid
  cycle_id         String?           @db.Uuid
  type             String            @db.VarChar(120)
  issuer           String            @db.VarChar(255)
  issue_date       DateTime          @db.Date
  expiry_date      DateTime?         @db.Date
  document_ref     String
  document_hash    String            @db.VarChar(128)
  is_public        Boolean           @default(false)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  production_cycle production_cycle? @relation(fields: [cycle_id], references: [cycle_id], onDelete: Restrict, onUpdate: NoAction)
  lot              lot?              @relation(fields: [lot_id], references: [lot_id], onDelete: Restrict, onUpdate: NoAction)

  @@index([cycle_id], map: "ix_certificate_cycle")
  @@index([lot_id], map: "ix_certificate_lot")
}

model farm {
  farm_id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String              @db.Uuid
  name             String              @db.VarChar(255)
  location         String?
  status           organization_status @default(ACTIVE)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @default(now()) @db.Timestamptz(6)
  organization     organization        @relation(fields: [organization_id], references: [organization_id], onUpdate: NoAction)
  plot             plot[]
  production_cycle production_cycle[]

  @@index([organization_id], map: "ix_farm_organization")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model harvest_event {
  harvest_id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycle_id               String           @db.Uuid
  final_sensor_digest_id String?          @unique @db.Uuid
  harvest_time           DateTime         @db.Timestamptz(6)
  quantity               Decimal          @db.Decimal(14, 3)
  unit                   String           @db.VarChar(30)
  quality_note           String?
  grade                  String?          @db.VarChar(100)
  harvest_area           String?          @db.VarChar(255)
  created_at             DateTime         @default(now()) @db.Timestamptz(6)
  production_cycle       production_cycle @relation(fields: [cycle_id], references: [cycle_id], onUpdate: NoAction)
  sensor_digest          sensor_digest?   @relation(fields: [final_sensor_digest_id], references: [digest_id], onDelete: Restrict, onUpdate: NoAction)
  lot                    lot?

  @@index([cycle_id, harvest_time], map: "ix_harvest_cycle_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model idempotency_record {
  idempotency_record_id String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotency_key       String             @db.VarChar(255)
  operation             String             @db.VarChar(100)
  request_type          String             @db.VarChar(100)
  request_hash          String             @db.VarChar(64)
  status                idempotency_status @default(PROCESSING)
  response_status       Int?
  response_body         Json?
  resource_id           String?            @db.VarChar(255)
  requester_id          String             @db.VarChar(255)
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @db.Timestamptz(6)
  expires_at            DateTime?          @db.Timestamptz(6)

  @@unique([requester_id, operation, idempotency_key], map: "uq_idempotency_request")
  @@index([expires_at], map: "ix_idempotency_expires")
  @@index([status], map: "ix_idempotency_status")
}

model inspection {
  inspection_id    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lot_id           String            @db.Uuid
  inspector_org_id String?           @db.Uuid
  result           inspection_result
  note             String?
  inspected_at     DateTime          @db.Timestamptz(6)
  evidence_ref     String?
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  organization     organization?     @relation(fields: [inspector_org_id], references: [organization_id], onDelete: Restrict, onUpdate: NoAction)
  lot              lot               @relation(fields: [lot_id], references: [lot_id], onUpdate: NoAction)

  @@index([lot_id, inspected_at], map: "ix_inspection_lot_time")
}

model iot_device {
  device_id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id           String                      @db.Uuid
  cycle_id                  String?                     @db.Uuid
  device_code               String                      @unique @db.VarChar(120)
  name                      String                      @db.VarChar(255)
  type                      String                      @db.VarChar(100)
  status                    device_status               @default(ACTIVE)
  last_seen_at              DateTime?                   @db.Timestamptz(6)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  production_cycle          production_cycle?           @relation(fields: [cycle_id], references: [cycle_id], onDelete: Restrict, onUpdate: NoAction)
  organization              organization                @relation(fields: [organization_id], references: [organization_id], onUpdate: NoAction)
  sensor_reading            sensor_reading[]
  shipment_telemetry        shipment_telemetry[]
  shipment_telemetry_digest shipment_telemetry_digest[]
  shipment_tracking_binding shipment_tracking_binding?

  @@index([cycle_id], map: "ix_iot_device_cycle")
  @@index([organization_id], map: "ix_iot_device_org")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model lot {
  lot_id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lot_code           String              @unique @db.VarChar(120)
  harvest_id         String              @unique @db.Uuid
  product_id         String              @db.Uuid
  farm_org_id        String              @db.Uuid
  initial_quantity   Decimal             @db.Decimal(14, 3)
  available_quantity Decimal             @db.Decimal(14, 3)
  unit               String              @db.VarChar(30)
  grade              String?             @db.VarChar(100)
  expiry_date        DateTime?           @db.Date
  current_state      lot_state           @default(HARVESTED)
  parent_lot_id      String?             @db.Uuid
  lineage_type       String?             @db.VarChar(100)
  version            Int                 @default(0)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @db.Timestamptz(6)
  certificate        certificate[]
  inspection         inspection[]
  organization       organization        @relation(fields: [farm_org_id], references: [organization_id], onUpdate: NoAction)
  harvest_event      harvest_event       @relation(fields: [harvest_id], references: [harvest_id], onUpdate: NoAction)
  lot                lot?                @relation("lotTolot", fields: [parent_lot_id], references: [lot_id], onDelete: Restrict, onUpdate: NoAction)
  other_lot          lot[]               @relation("lotTolot")
  product            product             @relation(fields: [product_id], references: [product_id], onUpdate: NoAction)
  quantity_movement  quantity_movement[]
  shipment           shipment?
  trace_event        trace_event[]
  trace_qr           trace_qr?

  @@index([farm_org_id], map: "ix_lot_farm_org")
  @@index([product_id], map: "ix_lot_product")
  @@index([current_state], map: "ix_lot_state")
}

model organization {
  organization_id                                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                               String                      @db.VarChar(255)
  type                                               organization_type
  status                                             organization_status         @default(ACTIVE)
  created_at                                         DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime                    @default(now()) @db.Timestamptz(6)
  app_user                                           User[]
  farm                                               farm[]
  inspection                                         inspection[]
  iot_device                                         iot_device[]
  lot                                                lot[]
  production_cycle                                   production_cycle[]
  shipment_shipment_retailer_org_idToorganization    shipment[]                  @relation("shipment_retailer_org_idToorganization")
  shipment_shipment_transporter_org_idToorganization shipment[]                  @relation("shipment_transporter_org_idToorganization")
  shipment_tracking_binding                          shipment_tracking_binding[]
  trace_event                                        trace_event[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model plot {
  plot_id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farm_id          String              @db.Uuid
  name             String              @db.VarChar(255)
  area             Decimal?            @db.Decimal(12, 2)
  unit             String?             @db.VarChar(30)
  location         String?
  status           organization_status @default(ACTIVE)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @default(now()) @db.Timestamptz(6)
  farm             farm                @relation(fields: [farm_id], references: [farm_id], onUpdate: NoAction)
  production_cycle production_cycle[]

  @@index([farm_id], map: "ix_plot_farm")
}

model product {
  product_id       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_name     String              @db.VarChar(255)
  variety          String?             @db.VarChar(255)
  default_unit     String?             @db.VarChar(30)
  description      String?
  status           organization_status @default(ACTIVE)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @default(now()) @db.Timestamptz(6)
  lot              lot[]
  production_cycle production_cycle[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model production_cycle {
  cycle_id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycle_code      String                 @db.VarChar(100)
  product_id      String                 @db.Uuid
  farm_id         String                 @db.Uuid
  farm_org_id     String                 @db.Uuid
  plot_id         String?                @db.Uuid
  start_date      DateTime?              @db.Date
  planned_harvest DateTime?              @db.Date
  current_state   production_cycle_state @default(CREATED)
  note            String?
  version         Int                    @default(0)
  created_at      DateTime               @default(now()) @db.Timestamptz(6)
  updated_at      DateTime               @default(now()) @db.Timestamptz(6)
  care_record     care_record[]
  certificate     certificate[]
  harvest_event   harvest_event[]
  iot_device      iot_device[]
  farm            farm                   @relation(fields: [farm_id], references: [farm_id], onUpdate: NoAction)
  organization    organization           @relation(fields: [farm_org_id], references: [organization_id], onUpdate: NoAction)
  plot            plot?                  @relation(fields: [plot_id], references: [plot_id], onDelete: Restrict, onUpdate: NoAction)
  product         product                @relation(fields: [product_id], references: [product_id], onUpdate: NoAction)
  sensor_digest   sensor_digest[]
  sensor_reading  sensor_reading[]
  trace_event     trace_event[]

  @@unique([farm_id, cycle_code], map: "uq_production_cycle_farm_code")
  @@index([farm_org_id], map: "ix_production_cycle_farm_org")
  @@index([product_id], map: "ix_production_cycle_product")
  @@index([current_state], map: "ix_production_cycle_state")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quantity_movement {
  movement_id String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lot_id      String      @db.Uuid
  event_id    String      @db.Uuid
  type        String      @db.VarChar(50)
  quantity    Decimal     @db.Decimal(14, 3)
  unit        String      @db.VarChar(30)
  before_qty  Decimal     @db.Decimal(14, 3)
  delta       Decimal     @db.Decimal(14, 3)
  after_qty   Decimal     @db.Decimal(14, 3)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  trace_event trace_event @relation(fields: [event_id], references: [event_id], onUpdate: NoAction)
  lot         lot         @relation(fields: [lot_id], references: [lot_id], onUpdate: NoAction)

  @@index([event_id], map: "ix_quantity_movement_event")
  @@index([lot_id, created_at], map: "ix_quantity_movement_lot_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sensor_digest {
  digest_id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycle_id                 String           @db.Uuid
  period_start             DateTime         @db.Timestamptz(6)
  period_end               DateTime         @db.Timestamptz(6)
  reading_count            Int
  digest_hash              String           @db.VarChar(64)
  schema_version           String           @default("sensor-digest-1") @db.VarChar(50)
  canonicalization_version String           @default("RFC8785-JCS-v1") @db.VarChar(50)
  is_final                 Boolean          @default(false)
  created_at               DateTime         @default(now()) @db.Timestamptz(6)
  harvest_event            harvest_event?
  production_cycle         production_cycle @relation(fields: [cycle_id], references: [cycle_id], onUpdate: NoAction)

  @@index([cycle_id, period_start, period_end], map: "ix_sensor_digest_cycle_period")
  @@index([digest_hash], map: "ix_sensor_digest_hash")
}

model sensor_reading {
  reading_id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  device_id        String           @db.Uuid
  cycle_id         String           @db.Uuid
  sensor_type      String           @db.VarChar(100)
  value            Decimal          @db.Decimal(16, 6)
  unit             String           @db.VarChar(30)
  recorded_at      DateTime         @db.Timestamptz(6)
  ingest_time      DateTime         @default(now()) @db.Timestamptz(6)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  production_cycle production_cycle @relation(fields: [cycle_id], references: [cycle_id], onUpdate: NoAction)
  iot_device       iot_device       @relation(fields: [device_id], references: [device_id], onUpdate: NoAction)

  @@index([cycle_id, recorded_at], map: "ix_sensor_reading_cycle_time")
  @@index([device_id, recorded_at], map: "ix_sensor_reading_device_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shipment {
  shipment_id                                            String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
