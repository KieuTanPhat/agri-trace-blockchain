  ledgerControlJobs       LedgerControlJob[]
  actorSignature          EventActorSignature?
  handoverOffers          ShipmentHandover[]    @relation("HandoverOfferEvent")
  handoverResolutions     ShipmentHandover[]    @relation("HandoverResolveEvent")

  @@index([cycleId, eventTime], map: "ix_trace_event_cycle_time")
  @@index([entityType, entityId], map: "ix_trace_event_entity")
  @@index([dataHash], map: "ix_trace_event_hash")
  @@index([lotId, eventTime], map: "ix_trace_event_lot_time")
  @@index([eventType], map: "ix_trace_event_type")
  @@map("trace_event")
}

/// Logical ledger destination; credentials and physical endpoints belong to bindings.
