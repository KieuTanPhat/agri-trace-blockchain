  /// HARVEST lots come from a harvest; TRANSFORMATION lots from a processing run.
  originType        String             @default("HARVEST") @map("origin_type") @db.VarChar(20)
  processingRunId   String?            @map("processing_run_id") @db.Uuid
  productId         String             @map("product_id") @db.Uuid
  farmOrgId         String             @map("farm_org_id") @db.Uuid
  initialQuantity   Decimal            @map("initial_quantity") @db.Decimal(14, 3)
  availableQuantity Decimal            @map("available_quantity") @db.Decimal(14, 3)
  unit              String             @db.VarChar(30)
  grade             String?            @db.VarChar(100)
  expiryDate        DateTime?          @map("expiry_date") @db.Date
  packageCount      Int?               @map("package_count")
  packaging         String?            @db.VarChar(255)
  packedAt          DateTime?          @map("packed_at") @db.Date
  initialStorageSiteId String?         @map("initial_storage_site_id") @db.Uuid
  currentState      LotState           @default(HARVESTED) @map("current_state")
  parentLotId       String?            @map("parent_lot_id") @db.Uuid
  lineageType       String?            @map("lineage_type") @db.VarChar(100)
  version           Int                @default(0)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  certificates      Certificate[]
  inspections       Inspection[]
  organization      Organization       @relation(fields: [farmOrgId], references: [id], onUpdate: NoAction)
  harvest           HarvestEvent?      @relation(fields: [harvestId], references: [id], onUpdate: NoAction)
  processingRun     ProcessingRun?     @relation("ProcessingRunLots", fields: [processingRunId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  processingInputs  ProcessingInput[]
  processingOutput  ProcessingOutput?
  distributionLines DistributionLine[]
  parentLot         Lot?               @relation("LotLineage", fields: [parentLotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  childLots         Lot[]              @relation("LotLineage")
  product           Product            @relation(fields: [productId], references: [id], onUpdate: NoAction)
  quantityMovements QuantityMovement[]
