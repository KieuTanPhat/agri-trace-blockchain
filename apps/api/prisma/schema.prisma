  shipped_quantity                                       Decimal                     @db.Decimal(14, 3)
  unit                                                   String                      @db.VarChar(30)
  planned_pickup_time                                    DateTime?                   @db.Timestamptz(6)
  expected_arrival_time                                  DateTime?                   @db.Timestamptz(6)
  pickup_time                                            DateTime?                   @db.Timestamptz(6)
  arrival_time                                           DateTime?                   @db.Timestamptz(6)
  received_time                                          DateTime?                   @db.Timestamptz(6)
  received_quantity                                      Decimal?                    @db.Decimal(14, 3)
  rejected_quantity                                      Decimal?                    @db.Decimal(14, 3)
  reject_reason                                          String?
  vehicle_ref                                            String?                     @db.VarChar(255)
  conditions                                             Json?
  status                                                 shipment_state              @default(CREATED)
