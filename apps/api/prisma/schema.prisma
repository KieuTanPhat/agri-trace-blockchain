  @@unique([shipment_id, period_start, period_end], map: "uq_tracking_digest_window")
  @@index([digest_hash], map: "ix_tracking_digest_hash")
  @@index([shipment_id, period_start, period_end], map: "ix_tracking_digest_shipment_period")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
