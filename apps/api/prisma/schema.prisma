generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// Operator-published consumer content. Plain text; independent of business events.
model ConsumerNews {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String    @db.VarChar(255)
  summary     String    @db.VarChar(1000)
  body        String    @db.VarChar(50000)
  coverUrl    String?   @map("cover_url") @db.VarChar(2048)
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([isPublished, publishedAt, id], map: "ix_consumer_news_public")
  @@map("consumer_news")
}

/// Public announcements, not organization/user notifications or domain alerts.
model ConsumerAnnouncement {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String    @db.VarChar(255)
  body      String    @db.VarChar(5000)
  severity  String    @default("INFO") @db.VarChar(16)
  isActive  Boolean   @default(false) @map("is_active")
  startsAt  DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([isActive, startsAt, id], map: "ix_consumer_announcement_public")
  @@map("consumer_announcement")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(120)
  description String?
  users       User[]

  @@map("app_role")
}

model User {
  phone                      String?                     @db.VarChar(30)
  jobTitle                   String?                     @map("job_title") @db.VarChar(255)
  workSiteId                 String?                     @map("work_site_id") @db.Uuid
  responsibleFarmId          String?                     @map("responsible_farm_id") @db.Uuid
  contactAddress             String?                     @map("contact_address") @db.VarChar(500)
  memberNote                 String?                     @map("member_note") @db.VarChar(1000)
  memberCode                 String?                     @map("member_code") @db.VarChar(20)
  platformCasesCreated PlatformCase[] @relation("PlatformCaseCreator")
  platformCaseEvents PlatformCaseEvent[]
  version                    Int                         @default(0) @map("version")
  failedLoginCount           Int                         @default(0) @map("failed_login_count")
  lockedUntil                DateTime?                   @map("locked_until") @db.Timestamptz(6)
  mustChangePassword         Boolean                     @default(false) @map("must_change_password")
  passwordChangedAt          DateTime?                   @map("password_changed_at") @db.Timestamptz(6)
  platformMfa                PlatformMfa?
  platformAudits             PlatformAudit[]
  platformApprovalsProposed  PlatformApproval[]          @relation("PlatformApprovalProposer")
  platformApprovalsDecided   PlatformApproval[]          @relation("PlatformApprovalDecider")
  enterpriseTier             Int? @map("enterprise_tier")
  supervisorId               String? @map("supervisor_id") @db.Uuid
  enterpriseRevision         Int @default(0) @map("enterprise_revision")
  enterpriseRoles            EnterpriseMemberRole[]
  enterpriseEnrollment EnterpriseEnrollment?
  ledgerPermissions          LedgerPermission[]
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  organizationId             String?                     @map("organization_id") @db.Uuid
  roleId                     String                      @map("role_id") @db.Uuid
  email                      String                      @db.VarChar(255)
  consumerProfile            ConsumerProfile?
  passwordHash               String                      @map("password_hash")
  fullName                   String                      @map("full_name") @db.VarChar(255)
  accountStatus              AccountStatus               @default(ACTIVE) @map("account_status")
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization               Organization?               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role                       Role                        @relation(fields: [roleId], references: [id], onUpdate: NoAction)
  trackingBindings           ShipmentTrackingBinding[]
  traceEvents                TraceEvent[]
  harvestRepresentations     HarvestEvent[]              @relation("HarvestRepresentative")
  refreshSessions            RefreshSession[]
  complianceAssignments      ComplianceAssignment[]
  complianceAssignmentAudits ComplianceAssignmentAudit[]
  submittedCertificates      Certificate[]
  recordedInspections        Inspection[]
  scopedGrants               ScopedRoleGrant[]
  chainAudits                ChainAudit[]
  shipmentPlanAcceptances    ShipmentPlanAcceptance[]
  signingKeysRegistered      SigningKey[]                @relation("SigningKeyRegistrant")
  signingIntents             SigningIntent[]             @relation("SigningIntentCreator")
  handoversOffered           ShipmentHandover[]          @relation("HandoverOfferer")
  handoversResolved          ShipmentHandover[]          @relation("HandoverResolver")

  @@unique([id, organizationId], map: "uq_user_org_scope")
  @@map("app_user")
  credentialMails             EnterpriseMail[]            @relation("AccountCredentialMail")
}

model ConsumerProfile {
  phone           String   @unique @db.VarChar(16)
  userId          String   @id @map("user_id") @db.Uuid
  contactEmail    String?  @map("contact_email") @db.VarChar(255)
  provinceCode    String   @map("province_code") @db.VarChar(10)
  provinceName    String   @map("province_name") @db.VarChar(255)
  wardCode        String   @map("ward_code") @db.VarChar(10)
  wardName        String   @map("ward_name") @db.VarChar(255)
  businessAddress String?  @map("business_address") @db.VarChar(255)
  consentVersion  String   @map("consent_version") @db.VarChar(120)
  consentedAt     DateTime @default(now()) @map("consented_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consumer_profile")
}

model ConsumerPhoneProof {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  proofKey  String   @unique @map("proof_key") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime @default(now()) @map("used_at") @db.Timestamptz(6)

  @@map("consumer_phone_proof")
}

model ConsumerAuthLimit {
  keyHash   String   @id @map("key_hash") @db.VarChar(64)
  windowAt  DateTime @map("window_at") @db.Timestamptz(6)
  attempts  Int

  @@map("consumer_auth_limit")
}

model RefreshSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @map("refresh_session_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, revokedAt], map: "ix_refresh_session_user_active")
  @@index([familyId, revokedAt, expiresAt], map: "ix_refresh_session_family_active")
  @@index([expiresAt], map: "ix_refresh_session_expiry")
  @@map("refresh_session")
}

model Organization {
  platformCasesOwned PlatformCase[] @relation("PlatformCaseOwner")
  platformCaseEvents PlatformCaseEvent[]
  version                 Int                       @default(0) @map("version")
  platformAudits          PlatformAudit[]
  platformApprovals       PlatformApproval[]
  profile                 EnterpriseProfile?
  registrationDocuments EnterpriseRegistrationDocument[]
  enterpriseRoles         EnterpriseRole[]
  enterpriseSites         EnterpriseSite[]
  enterpriseVehicles      EnterpriseVehicle[]
  products                Product[]
  enterpriseEnrollment EnterpriseEnrollment?
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @map("organization_id") @db.Uuid
  name                    String                    @db.VarChar(255)
  type                    OrganizationType
  status                  OrganizationStatus        @default(ACTIVE)
  /// SINGLE: one registered activity. SUPPLY_CHAIN_ENTERPRISE: several reviewed capabilities.
  participationModel      String                    @default("SINGLE") @map("participation_model") @db.VarChar(30)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  users                   User[]
  farms                   Farm[]
  inspections             Inspection[]
  devices                 IotDevice[]
  lots                    Lot[]
  productionCycles        ProductionCycle[]
  shipmentsAsRetailer     Shipment[]                @relation("ShipmentRetailer")
  shipmentsAsTransporter  Shipment[]                @relation("ShipmentTransporter")
  distributionsAsSender DistributionTransfer[] @relation("DistributionSender")
  distributionsAsCarrier DistributionTransfer[] @relation("DistributionCarrier")
  distributionsAsReceiver DistributionTransfer[] @relation("DistributionReceiver")
  trackingBindings        ShipmentTrackingBinding[]
  traceEvents             TraceEvent[]
  capabilities            OrganizationCapability[]
  capabilityRequests      CapabilityRequest[]
  subscriptions           Subscription[]
  supportTickets          SupportTicket[]
  invoices                Invoice[]
  ownedChains             SupplyChain[]
  chainMemberships        ChainMembership[]
  scopedGrants            ScopedRoleGrant[]
  stageAssignments        StageAssignment[]
  planProducerRevisions   ShipmentPlanRevision[]    @relation("PlanProducer")
  planTransportRevisions  ShipmentPlanRevision[]    @relation("PlanTransporter")
  planRetailRevisions     ShipmentPlanRevision[]    @relation("PlanRetailer")
  shipmentPlanAcceptances ShipmentPlanAcceptance[]
  signingKeys             SigningKey[]
  handoversGiven          ShipmentHandover[]        @relation("HandoverGiver")
  handoversReceived       ShipmentHandover[]        @relation("HandoverReceiver")

  @@map("organization")
}

/// Business capability of an organization. A capability never grants user
/// permissions or chain data access by itself.
model OrganizationCapability {
  organizationId String           @map("organization_id") @db.Uuid
  code           OrganizationType
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revision       Int              @default(0)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([organizationId, code])
  @@map("organization_capability")
}

/// Reviewable request for one registered capability. Approval never grants
/// business authority by itself; activation or an audited review does.
model CapabilityRequest {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  code           OrganizationType
  status         String           @default("PENDING") @db.VarChar(20)
  details        Json             @default("{}")
  evidenceIds    String[]         @default([]) @map("evidence_ids") @db.Uuid
  reviewNote     String?          @map("review_note") @db.VarChar(1000)
  reviewedBy     String?          @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  version        Int              @default(0)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, createdAt], map: "ix_capability_request_status")
  @@map("capability_request")
}

/// Plan family offered to paying participants.
model ServicePlan {
  code        String               @id @db.VarChar(30)
  name        String               @db.VarChar(120)
  audience    String               @db.VarChar(30)
  description String?              @db.VarChar(1000)
  status      String               @default("ACTIVE") @db.VarChar(20)
  sortOrder   Int                  @default(0) @map("sort_order")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  versions    ServicePlanVersion[]

  @@map("service_plan")
}

/// Published versions are immutable; quotations and subscriptions keep them.
model ServicePlanVersion {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planCode      String         @map("plan_code") @db.VarChar(30)
  version       Int
  setupFee      BigInt         @map("setup_fee")
  annualFee     BigInt         @map("annual_fee")
  termMonths    Int            @default(12) @map("term_months")
  limits        Json
  status        String         @default("DRAFT") @db.VarChar(20)
  note          String?        @db.VarChar(1000)
  createdBy     String?        @map("created_by") @db.Uuid
  publishedBy   String?        @map("published_by") @db.Uuid
  publishedAt   DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  plan          ServicePlan    @relation(fields: [planCode], references: [code], onDelete: Restrict, onUpdate: NoAction)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@unique([planCode, version])
  @@map("service_plan_version")
}

/// Effective GRACE/RESTRICTED states are derived from endsAt and the grace setting.
model Subscription {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  planVersionId String             @map("plan_version_id") @db.Uuid
  status        String             @default("PENDING_PAYMENT") @db.VarChar(20)
  startsAt      DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime?          @map("ends_at") @db.Timestamptz(6)
  sourceOrderId String?            @unique @map("source_order_id") @db.Uuid
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelReason  String?            @map("cancel_reason") @db.VarChar(1000)
  version       Int                @default(0)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  planVersion   ServicePlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invoices      Invoice[]

  @@map("subscription")
}

model Invoice {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number            String              @unique @db.VarChar(30)
  organizationId    String              @map("organization_id") @db.Uuid
  subscriptionId    String?             @map("subscription_id") @db.Uuid
  planVersionId     String?             @map("plan_version_id") @db.Uuid
  kind              String              @db.VarChar(20)
  lines             Json
  amount            BigInt
  currency          String              @default("VND") @db.VarChar(3)
  status            String              @default("ISSUED") @db.VarChar(20)
  issuedAt          DateTime            @default(now()) @map("issued_at") @db.Timestamptz(6)
  dueAt             DateTime            @map("due_at") @db.Timestamptz(6)
  paidAt            DateTime?           @map("paid_at") @db.Timestamptz(6)
  provider          String?             @db.VarChar(20)
  providerReference String?             @map("provider_reference") @db.VarChar(120)
  simulated         Boolean             @default(false)
  voidReason        String?             @map("void_reason") @db.VarChar(1000)
  createdBy         String?             @map("created_by") @db.Uuid
  version           Int                 @default(0)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  subscription      Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  planVersion       ServicePlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payments          InvoicePayment[]

  @@index([organizationId, issuedAt(sort: Desc)], map: "ix_invoice_org")
  @@index([status, dueAt], map: "ix_invoice_status")
  @@map("invoice")
}

model InvoicePayment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId  String   @map("invoice_id") @db.Uuid
  provider   String   @db.VarChar(20)
  amount     BigInt
  reference  String?  @db.VarChar(120)
  recordedBy String?  @map("recorded_by") @db.Uuid
  note       String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([invoiceId], map: "ix_invoice_payment_invoice")
  @@map("invoice_payment")
}

/// A processor consumes held input lots and creates finished lots. Completed
/// runs are immutable and must balance inputs against outputs and losses.
model ProcessingRun {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String             @unique @db.VarChar(40)
  organizationId  String             @map("organization_id") @db.Uuid
  chainId         String             @map("chain_id") @db.Uuid
  siteId          String             @map("site_id") @db.Uuid
  processType     String             @map("process_type") @db.VarChar(30)
  baseUnit        String             @map("base_unit") @db.VarChar(30)
  recipe          String?            @db.VarChar(500)
  note            String?            @db.VarChar(1000)
  status          String             @default("DRAFT") @db.VarChar(20)
  originCycleId   String?            @map("origin_cycle_id") @db.Uuid
  inputTotal      Decimal?           @map("input_total") @db.Decimal(14, 3)
  outputTotal     Decimal?           @map("output_total") @db.Decimal(14, 3)
  lossTotal       Decimal?           @map("loss_total") @db.Decimal(14, 3)
  variancePercent Decimal?           @map("variance_percent") @db.Decimal(9, 3)
  createdBy       String             @map("created_by") @db.Uuid
  completedBy     String?            @map("completed_by") @db.Uuid
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?            @map("cancel_reason") @db.VarChar(1000)
  version         Int                @default(0)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  inputs          ProcessingInput[]
  outputs         ProcessingOutput[]
  losses          ProcessingLoss[]
  lots            Lot[]              @relation("ProcessingRunLots")
  chain           SupplyChain        @relation(fields: [chainId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, createdAt(sort: Desc)], map: "ix_processing_run_org")
  @@index([chainId, status], map: "ix_processing_run_chain")
  @@map("processing_run")
}

model ProcessingInput {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId    String        @map("run_id") @db.Uuid
  lotId    String        @map("lot_id") @db.Uuid
  quantity Decimal       @db.Decimal(14, 3)
  unit     String        @db.VarChar(30)
  run      ProcessingRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lot      Lot           @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([runId, lotId])
  @@index([lotId], map: "ix_processing_input_lot")
  @@map("processing_input")
}

model ProcessingOutput {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId        String        @map("run_id") @db.Uuid
  productId    String        @map("product_id") @db.Uuid
  kind         String        @db.VarChar(20)
  quantity     Decimal       @db.Decimal(14, 3)
  unit         String        @db.VarChar(30)
  baseQuantity Decimal       @map("base_quantity") @db.Decimal(14, 3)
  lotName      String?       @map("lot_name") @db.VarChar(255)
  grade        String?       @db.VarChar(100)
  packaging    String?       @db.VarChar(255)
  packageCount Int?          @map("package_count")
  expiryDate   DateTime?     @map("expiry_date") @db.Date
  lotId        String?       @unique @map("lot_id") @db.Uuid
  run          ProcessingRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lot          Lot?          @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([runId], map: "ix_processing_output_run")
  @@map("processing_output")
}

model ProcessingLoss {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId    String        @map("run_id") @db.Uuid
  reason   String        @db.VarChar(30)
  quantity Decimal       @db.Decimal(14, 3)
  note     String?       @db.VarChar(500)
  run      ProcessingRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("processing_loss")
}

/// Administrative QR block. The page keeps resolving with a public warning.
model TraceQrBlock {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId         String    @map("lot_id") @db.Uuid
  reason        String    @db.VarChar(1000)
  publicMessage String    @map("public_message") @db.VarChar(500)
  blockedBy     String    @map("blocked_by") @db.Uuid
  blockedAt     DateTime  @default(now()) @map("blocked_at") @db.Timestamptz(6)
  unblockedBy   String?   @map("unblocked_by") @db.Uuid
  unblockedAt   DateTime? @map("unblocked_at") @db.Timestamptz(6)
  unblockReason String?   @map("unblock_reason") @db.VarChar(1000)
  version       Int       @default(0)

  @@map("trace_qr_block")
}

/// Anonymous daily scan counter per lot.
model TraceScanDaily {
  lotId String   @map("lot_id") @db.Uuid
  day   DateTime @db.Date
  scans Int      @default(0)

  @@id([lotId, day])
  @@index([day], map: "ix_trace_scan_daily_day")
  @@map("trace_scan_daily")
}

model SystemNotice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String    @db.VarChar(200)
  body        String    @db.VarChar(2000)
  audience    String    @db.VarChar(30)
  severity    String    @db.VarChar(20)
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime  @map("ends_at") @db.Timestamptz(6)
  status      String    @default("PUBLISHED") @db.VarChar(20)
  createdBy   String    @map("created_by") @db.Uuid
  withdrawnBy String?   @map("withdrawn_by") @db.Uuid
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, startsAt, endsAt], map: "ix_system_notice_active")
  @@map("system_notice")
}

model SupportTicket {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String           @unique @db.VarChar(30)
  organizationId String           @map("organization_id") @db.Uuid
  createdBy      String           @map("created_by") @db.Uuid
  category       String           @db.VarChar(30)
  priority       String           @default("NORMAL") @db.VarChar(20)
  subject        String           @db.VarChar(200)
  status         String           @default("OPEN") @db.VarChar(30)
  assigneeId     String?          @map("assignee_id") @db.Uuid
  dueAt          DateTime         @map("due_at") @db.Timestamptz(6)
  resolution     String?          @db.VarChar(2000)
  closedAt       DateTime?        @map("closed_at") @db.Timestamptz(6)
  version        Int              @default(0)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  messages       SupportMessage[]

  @@index([status, dueAt], map: "ix_support_ticket_status")
  @@index([organizationId, createdAt(sort: Desc)], map: "ix_support_ticket_org")
  @@map("support_ticket")
}

model SupportMessage {
