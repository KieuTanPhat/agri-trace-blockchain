  transporter_org_id String               @db.Uuid
  bound_at           DateTime             @default(now()) @db.Timestamptz(6)
  unbound_at         DateTime?            @db.Timestamptz(6)
  status             String               @default("ACTIVE") @db.VarChar(30)
  bound_by           String?              @db.Uuid
  note               String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  shipment_telemetry shipment_telemetry[]
  app_user           User?                @relation(fields: [bound_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  iot_device         iot_device           @relation(fields: [device_id], references: [device_id], onUpdate: NoAction)
  shipment           shipment             @relation(fields: [shipment_id], references: [shipment_id], onUpdate: NoAction)
  organization       organization         @relation(fields: [transporter_org_id], references: [organization_id], onUpdate: NoAction)

  @@index([device_id], map: "ix_tracking_binding_device")
  @@index([shipment_id], map: "ix_tracking_binding_shipment")
}

