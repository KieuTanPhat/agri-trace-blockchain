{
  "name": "@agri-traceability/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "npm run lint && node scripts/run-next.mjs build",
    "lint": "eslint src/ && oxlint --config .oxlintrc.json src/",
    "lint:contract": "node --test scripts/lint-contract.test.mjs",
    "test:image-optimizer": "node --test scripts/image-optimizer.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run lint:contract && npm run test:image-optimizer && npm run build"
  },
  "dependencies": {
    "@next/swc-wasm-nodejs": "^15.5.25",
    "lucide-react": "^1.41.0",
    "next": "^15.5.25",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/qrcode": "^1.5.6",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "eslint": "^9.18.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "oxlint": "^1.82.0",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
