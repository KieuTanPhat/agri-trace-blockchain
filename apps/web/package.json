{
  "name": "@agri-traceability/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "npm run lint && node scripts/run-next.mjs build",
    "lint": "eslint --max-warnings 0 src/ && oxlint --max-warnings 0 --config .oxlintrc.json src/",
    "lint:contract": "node --test scripts/lint-contract.test.mjs scripts/eslint-react-compat.test.mjs",
    "test:image-optimizer": "node --test scripts/image-optimizer.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run lint:contract && npm run test:image-optimizer && npm run build",
    "test:mobile": "tsc -p tsconfig.mobile-tests.json --noEmit && eslint --max-warnings 0 test-mobile/ && oxlint --max-warnings 0 --config .oxlintrc.json test-mobile/ && vitest run --config vitest.mobile.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "doctrine": "3.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^14.0.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.82.0",
    "semver": "7.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": "12.1.0"
  }
}
