NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# Enable only when this Web origin also proxies /api (the production image enables it at build time).
NEXT_PUBLIC_API_SAME_ORIGIN=false
NEXT_PUBLIC_TRACE_BASE_URL=http://localhost:3000/trace
NEXT_PUBLIC_MOCK_API=false

# Comma-separated dev hostnames/IPs, without scheme or port. Restart Next after changing.
# NEXT_DEV_ALLOWED_HOSTS=192.168.1.100
