# Fresh schema-3 production; generated secrets stay outside Git.
# API_IMAGE/WEB_IMAGE and release write mode are set by the installed controller.
POSTGRES_IMAGE=postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
POSTGRES_DB=agri_trace_prod
POSTGRES_USER=agritrace_prod
POSTGRES_PASSWORD=GENERATE_HEX_SECRET
JWT_SECRET=GENERATE_DIFFERENT_HEX_SECRET
# Separate 32-byte base64/64-hex key, generated privately. Empty disables secret-backed features.
PLATFORM_SECRET_KEY=
PLATFORM_MFA_MODE=OPTIONAL
PLATFORM_APPROVALS_MODE=OFF
PLATFORM_LOGIN_MAX_ATTEMPTS=5
PLATFORM_LOGIN_LOCK_MINUTES=15
PLATFORM_APPROVAL_TTL_HOURS=48
IOT_INGEST_API_KEY=GENERATE_DIFFERENT_HEX_SECRET
PUBLIC_ORIGIN=https://agritrace.dev
CORS_ORIGINS=https://agritrace.dev,https://www.agritrace.dev,https://nongtrace.site
HYBRID_WRITES_MODE=CLOSED
FABRIC_LEGACY_WRITER=false
WORKER_UID=1000
WORKER_GID=1000
HOSTED_WORKER_CONFIG_HOST=/opt/agri-trace/shared/config/worker
FABRIC_BINDINGS_CONFIG_HOST=/opt/agri-trace/shared/config/worker/bindings.json
HOSTED_WORKER_IDENTITIES_HOST=/opt/agri-trace/hosted/production-20261014/worker-identities
HOSTED_FABRIC_DOCKER_NETWORK=agritrace-prod-20261014-network
ENTERPRISE_ONBOARDING_ENABLED=false
ENTERPRISE_CONNECTIONS_CONFIG_HOST=/opt/agri-trace/shared/config/worker/enterprise-connections.json
# Binding connections are selected by immutable DB binding digest. The API
# receives no identity or legacy descriptor. Owner/admin2/CA keys stay operator-only.
