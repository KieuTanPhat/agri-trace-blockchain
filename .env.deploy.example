# Private production configuration; preserve adopted PGDATA and credentials.
# Never commit generated values. API_IMAGE/WEB_IMAGE are set by the controller.
POSTGRES_IMAGE=postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
POSTGRES_DB=agritrace_prod
POSTGRES_USER=agritrace_prod
POSTGRES_PASSWORD=GENERATE_HEX_SECRET
JWT_SECRET=GENERATE_DIFFERENT_HEX_SECRET
IOT_INGEST_API_KEY=GENERATE_DIFFERENT_HEX_SECRET
PUBLIC_ORIGIN=https://agritrace.dev
CORS_ORIGINS=https://agritrace.dev,https://www.agritrace.dev

# Hybrid first cutover: writers stay closed until mapping/history/floor gates.
# CANARY additionally requires reviewed technical actor UUIDs with current grants.
HYBRID_WRITES_MODE=CLOSED
HYBRID_CANARY_ACTOR_IDS=
# LEGACY_LEDGER_DESCRIPTOR_HOST=/opt/agri-trace/shared/legacy-ledger.json
# LEGACY_LEDGER_DESCRIPTOR_SHA256=<verified raw-byte sha256>
# LEDGER_WRITER_AUTHORITY=<retained legacy logical authority>
# FABRIC_BINDINGS_CONFIG_HOST=/opt/agri-trace/shared/hosted-bindings.json
# HOSTED_WORKER_IDENTITIES_HOST=/opt/agri-trace/shared/hosted-worker-identities
# HOSTED_FABRIC_DOCKER_NETWORK=<independent hosted network>

# Set paths/endpoints from the reviewed production binding; API gets no signer.
# FABRIC_CHANNEL_NAME=agritrace
# FABRIC_CHAINCODE_NAME=agritrace
# FABRIC_MSP_ID=Org1MSP
# FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051
# FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# WORKER_UID=1001
# WORKER_GID=1001
# RELAYER_MSP_DIR_HOST=/opt/agri-trace/shared/fabric/identities/relayer/msp
# FABRIC_TLS_CERT_HOST=/opt/agri-trace/shared/fabric/organizations/peer-ca.crt
