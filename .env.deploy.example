# Private administrator configuration, copied to each environment's shared root.
# Never commit generated values. API_IMAGE/WEB_IMAGE are set by the controller.
POSTGRES_IMAGE=postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
POSTGRES_DB=agritrace_dev
POSTGRES_USER=agritrace_dev
POSTGRES_PASSWORD=GENERATE_HEX_SECRET
JWT_SECRET=GENERATE_DIFFERENT_HEX_SECRET
IOT_INGEST_API_KEY=GENERATE_DIFFERENT_HEX_SECRET
PUBLIC_ORIGIN=https://nongtrace.site
CORS_ORIGINS=https://nongtrace.site,https://www.nongtrace.site

# Add only after provision/review of a separate Fabric dev network.
# FABRIC_CHANNEL_NAME=agritrace
# FABRIC_CHAINCODE_NAME=agritrace
# FABRIC_MSP_ID=Org1MSP
# FABRIC_PEER_ENDPOINT=agritrace-dev-peer1:7051
# FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# WORKER_UID=1001
# WORKER_GID=1001
# RELAYER_MSP_DIR_HOST=/opt/agri-trace-dev/shared/fabric/identities/relayer/msp
# FABRIC_TLS_CERT_HOST=/opt/agri-trace-dev/shared/fabric/organizations/peer-ca.crt
