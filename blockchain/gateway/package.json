{
  "name": "@agri-trace/fabric-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Fabric Gateway connection, binding ledger client and registry operations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": "12.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "runtime:load": "node -e \"require('./dist/index.js')\"",
    "check": "npm run typecheck && npm test && npm run build && npm run runtime:load"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@hyperledger/fabric-gateway": "1.12.1",
    "json-canonicalize": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.12"
  }
}
