{
  "name": "agri-trace-blockchain",
  "private": true,
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.1.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4",
    "undici": "6.29.0",
    "tmp": "0.2.7",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.2",
    "brace-expansion@^4.0.0": "5.0.12",
    "fast-uri@^3.0.0": "3.1.8",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "@swc/core@1.16.2": true,
    "@prisma/engines@7.10.0": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "protobufjs@7.6.6": true,
    "@scarf/scarf": false,
    "pkcs11js": false
  },
  "scripts": {
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "check:chaincode:standalone": "node scripts/check-standalone-chaincode.mjs",
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:worker": "npm run start:worker --workspace apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace apps/api",
    "test:ci": "node --test scripts/ci/ci.test.mjs",
    "test:worker-contract": "npm run build --workspace blockchain/gateway && npm run prisma:generate --workspace apps/api && npm run build --workspace apps/api && npm run build --workspace blockchain/chaincode && node --test scripts/ci/worker-contract.test.mjs",
    "check": "npm run build --workspace blockchain/gateway && npm run check --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "blockchain/chaincode",
    "blockchain/gateway"
  ]
}
