{
  "name": "agri-trace-blockchain",
  "private": true,
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": "12.1.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4",
    "undici": "6.29.1",
    "body-parser": "2.4.0",
    "multer": "2.5.0",
    "tmp": "0.2.7",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^4.0.0": "5.0.12",
    "fast-uri@^3.0.0": "3.1.9",
    "sharp": "0.35.5",
    "minimatch@<9": "$minimatch",
    "minimatch@>=9 <11": "11.0.3",
    "@redocly/openapi-core": {
      "minimatch": "$minimatch"
    }
  },
  "allowScripts": {
    "@swc/core@1.16.18": true,
    "@prisma/engines@7.10.0": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "protobufjs@7.6.6": true,
    "@scarf/scarf": false,
    "pkcs11js": false
  },
  "scripts": {
    "agents:sync": "node scripts/sync-agent-skills.mjs",
    "agents:check": "node scripts/check-agent-setup.mjs",
    "test:agents": "node --test scripts/agent-setup.test.mjs",
    "test:mobile:auth": "node --import tsx --test scripts/ci/mobile-phone.test.mts",
    "api-contract:generate": "npm run build --workspace apps/api && node scripts/generate-api-contract.mjs",
    "api-contract:check": "npm run build --workspace apps/api && node scripts/generate-api-contract.mjs --check",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "check:chaincode:standalone": "node scripts/check-standalone-chaincode.mjs",
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:worker": "npm run start:worker --workspace apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace apps/api",
    "test:hybrid:browser": "node scripts/ci/hybrid-browser.mjs",
    "test:enterprise:peer": "node scripts/ci/enterprise-peer.mjs",
    "test:ci": "node --test scripts/ci/ci.test.mjs scripts/demo/verification-initialization.test.mjs scripts/demo/seed-target.test.mjs scripts/demo/ui-workflow-plan.test.mjs deploy/ci/lib.test.mjs deploy/ci/migrations-immutable.test.mjs deploy/cd/gate.test.mjs deploy/cd/publish.test.mjs deploy/cd/send.test.mjs deploy/cd/session-auth.test.mjs && node --import tsx --test blockchain/network/hybrid/acceptance/export-check.test.mts",
    "check": "npm run agents:check && npm run test:agents && npm run test:ci && npm run build --workspace blockchain/gateway && npm run check --workspaces --if-present",
    "demo:ui:workflow": "node scripts/demo/seed-ui-workflow.mjs"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "blockchain/chaincode",
    "blockchain/gateway"
  ],
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "playwright": "1.62.1",
    "minimatch": "file:apps/mobile/compat/minimatch-legacy"
  }
}
