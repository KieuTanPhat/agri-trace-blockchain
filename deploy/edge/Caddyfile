{
    admin unix//tmp/caddy-admin.sock
}
(application) {
    encode gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
        X-XSS-Protection 0
        -Server
        -X-Powered-By
    }
    @docs path /api/docs /api/docs/* /api/docs-json /api/docs-yaml
    handle @docs {
        respond "Not found" 404
    }
    @api path /api /api/*
    handle @api {
        reverse_proxy {args[0]}:8080 {
            header_up X-Forwarded-For {http.request.remote.host}
        }
    }
    handle {
        reverse_proxy {args[1]}:3000
    }
}

agritrace.dev, www.agritrace.dev, nongtrace.site {
    # HTTPS only; do not advertise HSTS on the HTTP rehearsal or IP redirect.
    header Strict-Transport-Security "max-age=31536000"
    import application prod-api prod-web
}

# Keep IP links on the encrypted production origin, preserving their paths.
http://13.140.170.166 {
    redir https://agritrace.dev{uri} 308
}
