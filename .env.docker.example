# Copy this file to .env.docker and run:
# docker compose --env-file .env.docker up --build

POSTGRES_DB=agri_trace
POSTGRES_USER=agritrace
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_PORT=5432

# Compose builds the API DATABASE_URL with the internal hostname `postgres`.
# Do not replace that hostname with localhost inside the containers.

API_PORT=8080
WEB_PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_DAYS=30
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_REQUESTS=120
IOT_INGEST_API_KEY=replace-with-a-long-random-device-ingest-key

# The API never receives Fabric signing material. Only the worker reads these
# paths, and both mounts are read-only inside its container.
FABRIC_ENABLED=false
FABRIC_NETWORK_NAME=hyperledger-fabric
FABRIC_CHANNEL_NAME=agritrace
FABRIC_CHAINCODE_NAME=agritrace
FABRIC_CONTRACT_NAME=AgriTraceContract
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=host.docker.internal:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_SAMPLES_DIR_HOST=./blockchain/.fabric/fabric-samples
RELAYER_MSP_DIR_HOST=./blockchain/network/identities/relayer
FABRIC_WORKER_INTERVAL_MS=10000
FABRIC_WORKER_BATCH_SIZE=20
FABRIC_CLAIM_LEASE_MS=120000
FABRIC_MAX_RETRIES=5
FABRIC_MAX_RETRY_DELAY_MS=300000

CORS_ORIGIN=http://localhost:3000
PUBLIC_TRACE_BASE_URL=http://localhost:3000/trace
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_TRACE_BASE_URL=http://localhost:3000/trace
# NEXT_PUBLIC_* values are used by the browser, so they must remain reachable
# from the host machine rather than using the internal service names.
